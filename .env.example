# =============================================
# Verico 網站環境設定範本
# 使用方式:cp .env.example .env 然後填入實際值
# .env 已被 .gitignore 排除,絕不會進版控
# =============================================

# --- LLM(product-generator-v2 / product-manager 解析與翻譯用)---
OPENAI_API_KEY=sk-xxxx

# --- FTP 部署(upload_to_ftp.sh / upload_checksum_manifest.sh)---
FTP_HOST=ftp.example.com
FTP_USER=user@example.com
FTP_PASS=change-me

# 遠端根目錄(選填,預設 /)
#FTP_REMOTE_DIR=/

# 增量上傳並行數(選填,預設 8)
#UPLOAD_PARALLEL=8
