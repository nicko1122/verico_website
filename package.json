{
  "name": "verico",
  "version": "1.0.0",
  "description": "Verico - 專業電池與記憶體解決方案",
  "main": "index.js",
  "scripts": {
    "build": "npm run build:css && eleventy",
    "build:css": "tailwindcss -i ./src/assets/css/tailwind.css -o ./src/assets/css/style.css --watch",
    "build:css:prod": "tailwindcss -i ./src/assets/css/tailwind.css -o ./src/assets/css/style.css --minify",
    "serve": "npm run build:css:prod && eleventy --serve",
    "dev": "npm run build:css:prod && eleventy --serve --watch",
    "fastify": "npm run build && node server.js",
    "start": "node server.js",
    "static": "cd static && python3 -m http.server 3000",
    "static:dev": "cd static && python3 -m http.server 3000 --bind 0.0.0.0"
  },
  "keywords": ["eleventy", "static-site", "battery", "memory"],
  "author": "",
  "license": "ISC",
  "devDependencies": {
    "@11ty/eleventy": "^3.1.2",
    "@tailwindcss/typography": "^0.5.10",
    "autoprefixer": "^10.4.20",
    "postcss": "^8.4.49",
    "tailwindcss": "^3.4.17"
  },
  "dependencies": {
    "@fastify/static": "^8.2.0",
    "fastify": "^5.4.0",
    "serve": "^14.2.4"
  }
}
