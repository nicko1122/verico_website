---
layout: layout.njk
pagination:
  data: collections.allProducts
  size: 1
  alias: product
eleventyComputed:
  title: "{{ product[product.lang].name }}"
  lang: "{{ product.lang }}"
  permalink: "/{{ product.lang }}/products/{{ product[product.lang].name | slug }}/index.html"
---

{% set p = product[product.lang] %}

<main class="pt-16">
    <!-- Product Hero Section -->
    <section class="py-0 -mt-24">
        <div class="max-w-7xl mx-auto px-6">
            <div class="grid grid-cols-1 lg:grid-cols-2 gap-12 items-center min-h-[600px]">
                <!-- Product Image Carousel -->
                <div class="w-full h-full flex items-center justify-center">
                    <div class="w-full max-w-lg aspect-square relative rounded-2xl overflow-hidden border border-gray-200 bg-white shadow-lg">
                        <img id="main-carousel-image" src="{{ (( '/' + p.images[0]) | url) | v }}" alt="{{ p.name }} - Main View" class="w-full h-full object-cover cursor-zoom-in" data-index="0">
                        <div class="absolute bottom-4 left-1/2 -translate-x-1/2 flex gap-3 z-10">
                            {% for image in p.images %}
                            <button class="carousel-thumb border-2 {% if loop.first %}border-gray-400{% else %}border-transparent{% endif %} rounded-lg overflow-hidden w-14 h-14 bg-white p-0.5 transition" data-index="{{ loop.index0 }}">
                                <img src="{{ (( '/' + image) | url) | v }}" alt="{{ p.name }} - Thumbnail {{ loop.index }}" class="w-full h-full object-cover rounded-md">
                            </button>
                            {% endfor %}
                        </div>
                    </div>
                    <div id="image-modal" class="fixed inset-0 bg-black/70 flex items-center justify-center z-[9999] hidden">
                        <div class="relative max-w-4xl w-full mx-4">
                            <button id="close-modal-btn" class="absolute -top-12 right-0 bg-white rounded-full p-3 shadow-lg hover:bg-gray-100 transition z-[10000]">
                                <svg class="w-6 h-6 text-gray-700" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12"/></svg>
                            </button>
                            <img id="modal-image" src="" alt="Zoomed Product Image" class="w-full h-auto rounded-xl shadow-lg bg-white object-contain max-h-[80vh]">
                        </div>
                    </div>
                </div>
                <!-- Product Info -->
                <div class="w-full h-full flex items-center justify-center">
                    <div class="text-center lg:text-left max-w-lg bg-white rounded-2xl border border-gray-200 shadow-lg p-8">
                        <div class="mb-6">
                            <span class="bg-purple-500 text-white px-4 py-2 rounded-full text-sm font-medium">{{ p.category }}</span>
                        </div>
                        <h1 class="text-4xl font-bold text-gray-800 mb-6 leading-tight">{{ p.name }}</h1>
                        <p class="text-xl text-gray-600 mb-8 leading-relaxed">{{ p.description }}</p>
                        <div class="flex gap-4 justify-center lg:justify-start">
                            <button class="border border-gray-300 text-gray-700 px-10 py-4 rounded-lg font-medium hover:bg-gray-50 transition text-lg">{{ i18n[product.lang].buttons.contact_sales }}</button>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </section>

    <!-- Product Features Introduction -->
    <section class="py-16 bg-gray-50">
        <div class="max-w-5xl mx-auto px-6">
            <div class="text-center mb-12">
                <h2 class="text-2xl font-bold text-gray-800 mb-4">{{ p.detailed_features.title }}</h2>
                <p class="text-gray-600 max-w-2xl mx-auto">{{ p.detailed_features.subtitle }}</p>
            </div>
            <div class="grid md:grid-cols-2 gap-8 items-stretch">
                {% for feature in p.detailed_features.items %}
                <div class="feature-card bg-white rounded-xl border border-gray-200 p-8 h-full flex flex-col">
                    <div class="flex items-start gap-6 flex-1">
                        <div class="bg-purple-100 rounded-full p-4 flex-shrink-0">
                           <svg class="w-8 h-8 text-purple-600" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 10V3L4 14h7v7l9-11h-7z"/></svg>
                        </div>
                        <div class="flex-1 flex flex-col">
                            <h3 class="text-xl font-semibold text-gray-800 mb-3">{{ feature.title }}</h3>
                            <p class="text-gray-600 mb-4">{{ feature.description }}</p>
                            {% if feature.benefits %}
                            <div class="bg-gray-50 rounded-lg p-4 mb-4">
                                <h4 class="font-semibold text-gray-800 mb-2">{{ i18n[product.lang].product.key_benefits_title }}</h4>
                                <ul class="text-sm text-gray-600 space-y-1">
                                    {% for benefit in feature.benefits %}
                                    <li>• {{ benefit }}</li>
                                    {% endfor %}
                                </ul>
                            </div>
                            {% endif %}
                        </div>
                    </div>
                    {% if feature.image %}
                    <div class="w-full rounded-lg shadow-md overflow-hidden bg-white mt-auto">
                        <img src="{{ (( '/' + feature.image) | url) | v }}" alt="{{ feature.image_alt }}" class="w-full h-auto object-contain">
                    </div>
                    {% endif %}
                </div>
                {% endfor %}
            </div>
        </div>
    </section>

    <!-- Product Specifications -->
    <section class="py-16 bg-white">
        <div class="max-w-5xl mx-auto px-6">
            <div class="text-center mb-12">
                <h2 class="text-2xl font-bold text-gray-800 mb-4">{{ i18n[product.lang].product.specifications_title }}</h2>
                <p class="text-gray-600 max-w-2xl mx-auto">{{ p.specs_intro or '' }}</p>
            </div>
            <div class="grid md:grid-cols-2 gap-8">
                <div class="spec-card bg-white rounded-xl border border-gray-200 p-6">
                    <h3 class="text-xl font-semibold text-gray-800 mb-6">{{ i18n[product.lang].product.technical_specs_title }}</h3>
                    <table class="spec-table w-full">
                        {% for spec in p.specs %}
                        <tr>
                            <td>{{ spec.name }}</td>
                            <td>{{ spec.value }}</td>
                        </tr>
                        {% endfor %}
                    </table>
                </div>
                <div class="spec-card bg-white rounded-xl border border-gray-200 p-6">
                    <h3 class="text-xl font-semibold text-gray-800 mb-6">{{ i18n[product.lang].product.key_features_title }}</h3>
                    <div class="space-y-4">
                        {% for feature in p.features %}
                        <div class="flex items-start gap-3">
                            <div class="bg-green-100 rounded-full p-2 mt-1">
                                <svg class="w-4 h-4 text-green-600" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7"/></svg>
                            </div>
                            <div>
                                <h4 class="font-semibold text-gray-800">{{ feature }}</h4>
                            </div>
                        </div>
                        {% endfor %}
                    </div>
                </div>
            </div>
        </div>
    </section>

    <!-- Compatibility Section -->
    {% if p.compatibility %}
    <section class="py-16 bg-gray-50">
        <div class="max-w-5xl mx-auto px-6">
            <div class="text-center mb-12">
                <h2 class="text-2xl font-bold text-gray-800 mb-4">{{ p.compatibility.title }}</h2>
                <p class="text-gray-600 max-w-2xl mx-auto">{{ p.compatibility.subtitle }}</p>
            </div>
            <div class="grid grid-cols-2 md:grid-cols-4 gap-6">
                {% for cat in p.compatibility.categories %}
                 <div class="text-center">
                    <div class="bg-white rounded-full w-32 h-32 flex items-center justify-center mx-auto mb-4 overflow-hidden">
                       {% if cat.icon %}
                        <img src="{{ (( '/' + cat.icon) | url) | v }}" alt="{{ cat.name }}" class="w-20 h-20 object-contain" />
                      {% else %}
                        <svg class="w-20 h-20 text-gray-700" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 10V3L4 14h7v7l9-11h-7z"/></svg>
                      {% endif %}
                    </div>
                    <h3 class="font-semibold text-gray-800 mb-2">{{ cat.name }}</h3>
                    <p class="text-sm text-gray-600">{{ cat.details }}</p>
                </div>
                {% endfor %}
            </div>
        </div>
    </section>
    {% endif %}

    <!-- Package Contents -->
    {% if p.package_contents %}
    <section class="py-16 bg-white">
        <div class="max-w-5xl mx-auto px-6">
            <div class="text-center mb-12">
                <h2 class="text-2xl font-bold text-gray-800 mb-4">{{ p.package_contents.title }}</h2>
                <p class="text-gray-600 max-w-2xl mx-auto">{{ p.package_contents.subtitle }}</p>
            </div>
            <div class="grid md:grid-cols-3 gap-8">
                {% for item in p.package_contents.items %}
                <div class="text-center">
                    <div class="aspect-[4/3] w-full overflow-hidden rounded-lg mb-4 bg-gray-50 flex items-center justify-center">
                       {% if item.icon %}
                        <img src="{{ (( '/' + item.icon) | url) | v }}" alt="{{ item.name }}" class="w-full h-full object-contain" />
                      {% else %}
                        <svg class="w-10 h-10 text-gray-700" viewBox="0 0 24 24" fill="none" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 7l9 4 9-4m-18 0l9-4 9 4m-18 0v10l9 4 9-4V7"/></svg>
                      {% endif %}
                    </div>
                    <h3 class="font-semibold text-gray-800 mb-2">{{ item.name }}</h3>
                    <p class="text-sm text-gray-600">{{ item.details }}</p>
                </div>
                {% endfor %}
            </div>
        </div>
    </section>
    {% endif %}

    <!-- Variants (Also Available In) -->
    {% if p.variants %}
    <section class="py-16 bg-gray-50">
        <div class="max-w-6xl mx-auto px-6">
            <div class="text-center mb-12">
                <h2 class="text-2xl font-bold text-gray-800 mb-4">{{ i18n[product.lang].product.also_available_in_title }}</h2>
                <p class="text-gray-600 max-w-2xl mx-auto">{{ i18n[product.lang].product.also_available_in_subtitle }}</p>
            </div>
            <div class="grid sm:grid-cols-2 lg:grid-cols-3 gap-6">
                {% for v in p.variants %}
                <div class="bg-white border border-gray-200 rounded-xl p-6">
                    {% if v.package_image %}
                    <div class="aspect-[4/3] w-full overflow-hidden rounded-lg mb-4 bg-gray-50">
                        <img src="{{ (( '/' + v.package_image) | url) | v }}" alt="{{ v.title }}" class="w-full h-full object-cover">
                    </div>
                    {% endif %}
                    <h3 class="text-lg font-semibold text-gray-800 mb-2">{{ v.title }}</h3>
                    {% if v.model_name %}<p class="text-sm text-gray-700"><span class="font-medium">Model Name:</span> {{ v.model_name }}</p>{% endif %}
                    {% if v.sku %}<p class="text-sm text-gray-700"><span class="font-medium">SKU:</span> {{ v.sku }}</p>{% endif %}
                    {% if v.ean %}<p class="text-sm text-gray-700"><span class="font-medium">EAN:</span> {{ v.ean }}</p>{% endif %}
                </div>
                {% endfor %}
            </div>
        </div>
    </section>
    {% endif %}
</main>

<script>
document.addEventListener('DOMContentLoaded', function () {
    const images = [
        {% for image in p.images %}
            "{{ (( '/' + image) | url) | v }}"{% if not loop.last %},{% endif %}
        {% endfor %}
    ];
    const mainImg = document.getElementById('main-carousel-image');
    const thumbs = document.querySelectorAll('.carousel-thumb');
    let currentIndex = 0;

    function showImage(idx) {
        if(!images[idx]) return;
        currentIndex = idx;
        mainImg.src = images[idx];
        mainImg.setAttribute('data-index', idx);
        thumbs.forEach(t => t.classList.remove('border-gray-400'));
        thumbs[idx].classList.add('border-gray-400');
    }

    showImage(0);

    thumbs.forEach((btn, idx) => {
        btn.addEventListener('click', function () { showImage(idx); });
    });

    const modal = document.getElementById('image-modal');
    const modalImg = document.getElementById('modal-image');
    mainImg.addEventListener('click', function () {
        if(!images[currentIndex]) return;
        modalImg.src = images[currentIndex];
        modal.classList.remove('hidden');
    });

    document.getElementById('close-modal-btn').addEventListener('click', function () {
        modal.classList.add('hidden');
        modalImg.src = '';
    });

    modal.addEventListener('click', function (e) {
        if (e.target === modal) {
            modal.classList.add('hidden');
            modalImg.src = '';
        }
    });
});
</script>
