---
layout: base.njk
title: Home
description: We care & We share
---

<!-- Hero Section: Static Image -->
<section class="relative w-[99%] h-[800px]">
    <div class="hero-wrapper rounded-2xl border border-gray-200 mx-2 my-3 md:mx-4 md:my-4 overflow-hidden h-full"
         style="box-sizing:border-box;">
        <div class="hero-container relative w-full h-full mx-auto">
            <img src="{{ site.hero.image }}" alt="Verico Hero Banner"
                class="w-full h-full object-cover object-center" />
            <div class="absolute inset-y-10 right-0 flex items-center pr-10">
                <h1 class="text-5xl font-bold text-gray-500 break-words text-left px-6 py-4">
                    {{ site.hero.title | safe }}
                </h1>
            </div>
        </div>
    </div>
</section>

<!-- Products Section -->
<section class="py-5">
    <div class="max-w-6xl mx-auto px-6 ">
        <div class="mb-3 mt-0">
            <h1 class="text-5xl font-bold tracking-tight text-gray-800 mb-0 mt-0 break-words text-center">
                {{ site.productCategories.title }}</h1>
        </div>
        <div class="flex justify-center gap-3 my-6">
            {% for button in site.productCategories.buttons %}
            <button
                class="px-4 py-1.5 bg-white border border-gray-200 text-gray-700 rounded-lg font-medium text-xs focus:outline-none"
                style="letter-spacing:0.01em;">{{ button.text }}</button>
            {% endfor %}
        </div>
        <div class="flex flex-col md:flex-row w-full h-auto md:h-[400px] gap-4">
            {% for category in site.productCategories.categories %}
            <div
                class="relative overflow-hidden rounded-2xl flex-1 md:group md:transition-all md:duration-300 md:hover:flex-[4]">
                <img src="{{ category.image }}"
                    class="w-full h-56 md:h-full object-cover" />
                <div class="absolute top-0 left-0 p-5">
                    <h3 class="text-xl font-semibold {{ category.textColor }} mb-2">{{ category.title }}</h3>
                    <p class="{{ category.textColor }} text-sm">{{ category.subtitle }}</p>
                </div>
            </div>
            {% endfor %}
        </div>
    </div>
</section>

<!-- Trending Products Block Grid -->
<section class="py-8">
    <div class="max-w-6xl mx-auto px-6">
        <div class="mb-8">
            <h1 class="text-5xl font-bold tracking-tight text-gray-800 text-center mb-2">
                {{ site.trendingProducts.title }}
            </h1>
        </div>
        <div class="grid grid-cols-1 sm:grid-cols-2 md:grid-cols-3 gap-8">
            {% for product in site.trendingProducts.products %}
            <div class="flex flex-col items-center">
                <a href="{{ product.url }}" class="block w-full">
                    <div class="bg-white border border-gray-200 rounded-2xl shadow-md flex flex-col items-center w-full max-w-xs mx-auto pb-6 hover:shadow-lg transition-shadow">
                        <div class="w-full rounded-t-2xl overflow-hidden bg-gray-50 pt-6 px-6">
                            <img src="{{ product.image }}" alt="{{ product.name }}" class="object-contain w-full mx-auto" />
                        </div>
                        <div class="w-full mt-6 px-4 text-left">
                            <h3 class="font-bold text-gray-800 mb-1 text-2xl">{{ product.name }}</h3>
                            <p class="text-gray-600 text-sm mb-1">{{ product.description }}</p>
                            <p class="text-gray-500 text-xs">{{ product.subtitle }}</p>
                        </div>
                    </div>
                </a>
            </div>
            {% endfor %}
        </div>
    </div>
</section> 
</section> 
</section> 