---
title: Kontakt
lang: de
permalink: /de/contact/
---

{% set data = contact.de %}

<!-- Hero Section -->
<section class="py-16 bg-gray-50">
    <div class="max-w-5xl mx-auto px-6 text-center">
        <h1 class="text-4xl font-bold tracking-tight text-gray-800 mb-4">
            {{ data.hero.title }}
        </h1>
        <p class="text-lg text-gray-600 max-w-2xl mx-auto">
            {{ data.hero.description }}
        </p>
    </div>
</section>

<!-- Contact Information -->
<section class="py-16 bg-white">
    <div class="max-w-5xl mx-auto px-6">
        <div class="grid md:grid-cols-3 gap-8 mb-16">
            <!-- Phone Contact -->
            <div class="contact-card bg-white rounded-xl border border-gray-200 p-8 text-center">
                <div class="bg-blue-100 rounded-full w-16 h-16 flex items-center justify-center mx-auto mb-4">
                    <svg class="w-8 h-8 text-blue-600 contact-icon" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 5a2 2 0 012-2h3.28a1 1 0 01.948.684l1.498 4.493a1 1 0 01-.502 1.21l-2.257 1.13a11.042 11.042 0 005.516 5.516l1.13-2.257a1 1 0 011.21-.502l4.493 1.498a1 1 0 01.684.949V19a2 2 0 01-2 2h-1C9.716 21 3 14.284 3 6V5z"></path>
                    </svg>
                </div>
                <h3 class="text-xl font-semibold text-gray-800 mb-2">Telefon</h3>
                <p class="text-gray-600 mb-4">Rufen Sie uns für sofortige Hilfe an</p>
                <div class="space-y-2">
                    <p class="text-lg font-medium text-gray-800">{{ data.contact_info.methods[0].value }}</p>
                    <p class="text-sm text-gray-500">Montag - Freitag: 9:00 - 18:00 Uhr</p>
                </div>
            </div>

            <!-- Email Contact -->
            <div class="contact-card bg-white rounded-xl border border-gray-200 p-8 text-center">
                <div class="bg-green-100 rounded-full w-16 h-16 flex items-center justify-center mx-auto mb-4">
                    <svg class="w-8 h-8 text-green-600 contact-icon" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 8l7.89 4.26a2 2 0 002.22 0L21 8M5 19h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z"></path>
                    </svg>
                </div>
                <h3 class="text-xl font-semibold text-gray-800 mb-2">E-Mail</h3>
                <p class="text-gray-600 mb-4">Senden Sie uns jederzeit eine Nachricht</p>
                <div class="space-y-2">
                    <p class="text-lg font-medium text-gray-800">{{ data.contact_info.methods[1].value }}</p>
                    <p class="text-sm text-gray-500">Wir antworten innerhalb von 24 Stunden</p>
                </div>
            </div>

            <!-- Office Contact -->
            <div class="contact-card bg-white rounded-xl border border-gray-200 p-8 text-center">
                <div class="bg-purple-100 rounded-full w-16 h-16 flex items-center justify-center mx-auto mb-4">
                    <svg class="w-8 h-8 text-purple-600 contact-icon" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17.657 16.657L13.414 20.9a1.998 1.998 0 01-2.827 0l-4.244-4.243a8 8 0 1111.314 0z"></path>
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 11a3 3 0 11-6 0 3 3 0 016 0z"></path>
                    </svg>
                </div>
                <h3 class="text-xl font-semibold text-gray-800 mb-2">Büro</h3>
                <p class="text-gray-600 mb-4">Besuchen Sie uns persönlich</p>
                <div class="space-y-2">
                    <p class="text-lg font-medium text-gray-800">Taipei, Taiwan</p>
                    <p class="text-sm text-gray-500">{{ data.contact_info.methods[2].value }}</p>
                </div>
            </div>
        </div>

        <!-- Contact Form and Map -->
        <div class="grid lg:grid-cols-2 gap-12">
            <!-- Contact Form -->
            <div class="bg-white rounded-xl border border-gray-200 p-8">
                <h2 class="text-2xl font-bold text-gray-800 mb-6">{{ data.form.title }}</h2>
                <form id="contact-form" class="space-y-6">
                    {% for field in data.form.fields %}
                    <div class="{% if field.type == 'text' and loop.index <= 2 %}grid md:grid-cols-2 gap-6{% endif %}">
                        <div>
                            <label for="{{ field.label | lower | replace(' ', '-') }}" class="block text-sm font-medium text-gray-700 mb-2">{{ field.label }}</label>
                            {% if field.type == 'text' or field.type == 'email' %}
                            <input type="{{ field.type }}" id="{{ field.label | lower | replace(' ', '-') }}" name="{{ field.label | lower | replace(' ', '-') }}" 
                                   {% if field.required %}required{% endif %}
                                   class="form-input w-full px-4 py-3 border border-gray-300 rounded-lg focus:outline-none focus:ring-2 focus:ring-blue-500 focus:border-transparent">
                            {% elif field.type == 'select' %}
                            <select id="{{ field.label | lower | replace(' ', '-') }}" name="{{ field.label | lower | replace(' ', '-') }}" 
                                    {% if field.required %}required{% endif %}
                                    class="form-input w-full px-4 py-3 border border-gray-300 rounded-lg focus:outline-none focus:ring-2 focus:ring-blue-500 focus:border-transparent">
                                {% for option in field.options %}
                                <option value="{{ option.value }}">{{ option.text }}</option>
                                {% endfor %}
                            </select>
                            {% elif field.type == 'textarea' %}
                            <textarea id="{{ field.label | lower | replace(' ', '-') }}" name="{{ field.label | lower | replace(' ', '-') }}" 
                                      rows="{{ field.rows }}" {% if field.required %}required{% endif %}
                                      class="form-input w-full px-4 py-3 border border-gray-300 rounded-lg focus:outline-none focus:ring-2 focus:ring-blue-500 focus:border-transparent resize-none"></textarea>
                            {% endif %}
                        </div>
                    </div>
                    {% endfor %}
                    
                    <button type="submit" id="submit-btn"
                            class="w-full bg-gray-800 text-white py-3 px-6 rounded-lg font-medium hover:bg-gray-700 transition duration-300">
                        {{ data.form.submit_text }}
                    </button>
                </form>
            </div>

            <!-- Map and Company Info -->
            <div class="space-y-8">
                <!-- Map -->
                <div class="bg-white rounded-xl border border-gray-200 overflow-hidden">
                    <div class="h-64 bg-gray-200 relative">
                        <img src="assets/images/banner/contact-banner.jpg" alt="Office Location" 
                             class="w-full h-full object-cover">
                        <div class="absolute inset-0 bg-black bg-opacity-20 flex items-center justify-center">
                            <div class="bg-white rounded-lg p-4 shadow-lg">
                                <h3 class="font-semibold text-gray-800 mb-2">Unser Büro</h3>
                                <p class="text-sm text-gray-600">{{ data.contact_info.methods[2].value }}</p>
                            </div>
                        </div>
                    </div>
                </div>

                <!-- Company Information -->
                <div class="bg-white rounded-xl border border-gray-200 p-8">
                    <h3 class="text-xl font-semibold text-gray-800 mb-6">Firmeninformationen</h3>
                    <div class="space-y-4">
                        {% for item in data.office.hours %}
                        <div class="flex items-start gap-3">
                            <svg class="w-5 h-5 text-gray-400 mt-1 flex-shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                {% if item.icon == "building" %}
                                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 21V5a2 2 0 00-2-2H7a2 2 0 00-2 2v16m14 0h2m-2 0h-5m-9 0H3m2 0h5M9 7h1m-1 4h1m4-4h1m-1 4h1m-5 10v-5a1 1 0 011-1h2a1 1 0 011 1v5m-4 0h4"></path>
                                {% elif item.icon == "clock" %}
                                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8v4l3 3m6-3a9 9 0 11-18 0 9 9 0 0118 0z"></path>
                                {% elif item.icon == "check" %}
                                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m6 2a9 9 0 11-18 0 9 9 0 0118 0z"></path>
                                {% endif %}
                            </svg>
                            <div>
                                <h4 class="font-medium text-gray-800">{{ item.day }}</h4>
                                <p class="text-sm text-gray-600">{{ item.time }}</p>
                            </div>
                        </div>
                        {% endfor %}
                    </div>
                </div>
            </div>
        </div>
    </div>
</section>

<!-- FAQ Section -->
<section class="py-16 bg-gray-50">
    <div class="max-w-5xl mx-auto px-6">
        <div class="text-center mb-12">
            <h2 class="text-3xl font-bold text-gray-800 mb-4">{{ data.faq.title }}</h2>
            <p class="text-gray-600 max-w-2xl mx-auto">
                {{ data.faq.subtitle }}
            </p>
        </div>

        <div class="grid md:grid-cols-2 gap-8">
            {% for faq in data.faq.items %}
            <div class="bg-white rounded-xl border border-gray-200 p-6">
                <h3 class="text-lg font-semibold text-gray-800 mb-3">{{ faq.question }}</h3>
                <p class="text-gray-600 text-sm">
                    {{ faq.answer }}
                </p>
            </div>
            {% endfor %}
        </div>
    </div>
</section> 