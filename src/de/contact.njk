---
layout: layout.njk
title: Kontakt
lang: de
permalink: /de/contact/index.html
---
{% set data = contact.de %}

<!-- Hero Section -->
<section class="relative w-[99%] h-[300px] mx-auto mb-8">
  <div class="hero-wrapper rounded-2xl border border-gray-200 overflow-hidden h-full" style="box-sizing:border-box;">
    <div class="hero-container relative w-full h-full mx-auto">
      <img src="{{ ('/' + data.hero.image) | url }}" alt="{{ data.hero.title }}" class="w-full h-full object-cover object-center" />
      <div class="absolute inset-y-10 right-0 flex items-center pr-10">
        <h1 class="text-5xl font-bold text-gray-500 break-words text-left px-6 py-4">{{ data.hero.title | safe }}</h1>
      </div>
    </div>
  </div>
</section>

<!-- Contact Information -->
<section class="py-16 bg-white">
    <div class="max-w-5xl mx-auto px-6">
        <div class="grid md:grid-cols-3 gap-8 mb-16">
            {% for method in data.contact_methods %}
            <div class="contact-card bg-white rounded-xl border border-gray-200 p-8 text-center">
                <div class="bg-blue-100 rounded-full w-16 h-16 flex items-center justify-center mx-auto mb-4">
                    <img src="{{ ('/' + method.icon) | url }}" alt="{{ method.title }}" class="w-8 h-8 object-contain" />
                </div>
                <h3 class="text-xl font-semibold text-gray-800 mb-2">{{ method.title }}</h3>
                <p class="text-gray-600 mb-4">{{ method.description }}</p>
                <div class="space-y-2">
                    <p class="text-lg font-medium text-gray-800">{{ method.details }}</p>
                    <p class="text-sm text-gray-500">{{ method.meta }}</p>
                </div>
            </div>
            {% endfor %}
        </div>

        <!-- Contact Form and Map -->
        <div class="grid lg:grid-cols-2 gap-12">
            <!-- Contact Form -->
            <div class="bg-white rounded-xl border border-gray-200 p-8">
                <h2 class="text-2xl font-bold text-gray-800 mb-6">{{ data.form.title }}</h2>
                <form id="contact-form" class="space-y-6">
                    <div class="grid md:grid-cols-2 gap-6">
                        <div>
                            <label for="name" class="block text-sm font-medium text-gray-700 mb-2">{{ data.form.fields.full_name.label }}</label>
                            <input type="text" id="name" name="name" {% if data.form.fields.full_name.required %}required{% endif %} class="form-input w-full px-4 py-3 border border-gray-300 rounded-lg focus:outline-none focus:ring-2 focus:ring-blue-500 focus:border-transparent">
                        </div>
                        <div>
                            <label for="email" class="block text-sm font-medium text-gray-700 mb-2">{{ data.form.fields.email.label }}</label>
                            <input type="email" id="email" name="email" {% if data.form.fields.email.required %}required{% endif %} class="form-input w-full px-4 py-3 border border-gray-300 rounded-lg focus:outline-none focus:ring-2 focus:ring-blue-500 focus:border-transparent">
                        </div>
                    </div>
                    <div>
                        <label for="company" class="block text-sm font-medium text-gray-700 mb-2">{{ data.form.fields.company.label }}</label>
                        <input type="text" id="company" name="company" class="form-input w-full px-4 py-3 border border-gray-300 rounded-lg focus:outline-none focus:ring-2 focus:ring-blue-500 focus:border-transparent">
                    </div>
                    <div>
                        <label for="subject" class="block text-sm font-medium text-gray-700 mb-2">{{ data.form.fields.subject.label }}</label>
                        <select id="subject" name="subject" {% if data.form.fields.subject.required %}required{% endif %} class="form-input w-full px-4 py-3 border border-gray-300 rounded-lg focus:outline-none focus:ring-2 focus:ring-blue-500 focus:border-transparent">
                            {% for option in data.form.fields.subject.options %}
                            <option value="{{ option.value }}">{{ option.text }}</option>
                            {% endfor %}
                        </select>
                    </div>
                    <div>
                        <label for="message" class="block text-sm font-medium text-gray-700 mb-2">{{ data.form.fields.message.label }}</label>
                        <textarea id="message" name="message" rows="6" {% if data.form.fields.message.required %}required{% endif %} class="form-input w-full px-4 py-3 border border-gray-300 rounded-lg focus:outline-none focus:ring-2 focus:ring-blue-500 focus:border-transparent resize-none"></textarea>
                    </div>
                    <button type="submit" id="submit-btn" class="w-full bg-gray-800 text-white py-3 px-6 rounded-lg font-medium hover:bg-gray-700 transition duration-300">
                        {{ data.form.submit_button }}
                    </button>
                </form>
            </div>

            <!-- Map and Company Info -->
            <div class="space-y-8">
                <!-- Address (map image removed) -->
                <div class="bg-white rounded-xl border border-gray-200 p-6">
                    <h3 class="font-semibold text-gray-800 mb-2">{{ data.map.overlay.title }}</h3>
                    <div class="text-sm text-gray-600 mb-4">
                        {% set a = data.map.overlay.address %}
                        {% if a.street %}{{ a.street }}<br/>{% endif %}
                        {% if a.city_postal %}{{ a.city_postal }}<br/>{% endif %}
                        {% if a.country %}{{ a.country }}<br/>{% endif %}
                        {% if a.contact_note %}{{ a.contact_note }}<br/>{% endif %}
                        {% if a.registry %}{{ a.registry }}<br/>{% endif %}
                        {% if a.tax_id %}{{ a.tax_id }}<br/>{% endif %}
                        {% if a.bank %}{{ a.bank }}<br/>{% endif %}
                    </div>
                </div>
                <div class="bg-white rounded-xl border border-gray-200 p-8">
                    <h3 class="text-xl font-semibold text-gray-800 mb-6">{{ data.company_info.title }}</h3>
                    <div class="space-y-4">
                        {% for info in data.company_info.items %}
                        <div class="flex items-start gap-3">
                            {% if info.icon %}
                            <img src="{{ ('/' + info.icon) | url }}" alt="{{ info.title }}" class="w-5 h-5 text-gray-400 mt-1 flex-shrink-0 object-contain" />
                            {% else %}
                            <svg class="w-5 h-5 text-gray-400 mt-1 flex-shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                {# fallback icon placeholder #}
                            </svg>
                            {% endif %}
                            <div>
                                <h4 class="font-medium text-gray-800">{{ info.title }}</h4>
                                <p class="text-sm text-gray-600">{{ info.details | safe }}</p>
                            </div>
                        </div>
                        {% endfor %}
                    </div>
                </div>
            </div>
        </div>
    </div>
</section>

<script>
document.addEventListener('DOMContentLoaded', function () {
    const form = document.getElementById('contact-form');
    if (!form) return;
    form.addEventListener('submit', function (e) {
        e.preventDefault();
        const to = "{{ i18n[lang].buttons.contact_sales_email }}";
        const pageTitle = "{{ data.form.title | escape }}";
        const name = document.getElementById('name')?.value || '';
        const email = document.getElementById('email')?.value || '';
        const company = document.getElementById('company')?.value || '';
        const subjectEl = document.getElementById('subject');
        const subjectText = subjectEl ? subjectEl.options[subjectEl.selectedIndex].text : '';
        const message = document.getElementById('message')?.value || '';

        const mailSubject = encodeURIComponent(pageTitle + (subjectText ? ' - ' + subjectText : ''));
        let body = '';
        body += 'Name: ' + name + '\r\n';
        body += 'Email: ' + email + '\r\n';
        body += 'Company: ' + company + '\r\n';
        body += 'Subject: ' + subjectText + '\r\n\r\n';
        body += message;

        const mailto = 'mailto:' + to + '?subject=' + mailSubject + '&body=' + encodeURIComponent(body);
        window.location.href = mailto;
    });
});
</script>

<!-- FAQ Section -->
<section class="py-16 bg-gray-50">
    <div class="max-w-5xl mx-auto px-6">
        <div class="text-center mb-12">
            <h2 class="text-3xl font-bold text-gray-800 mb-4">{{ data.faq.title }}</h2>
            <p class="text-gray-600 max-w-2xl mx-auto">{{ data.faq.subtitle }}</p>
        </div>
        <div class="grid md:grid-cols-2 gap-8">
            {% for item in data.faq.items %}
            <div class="bg-white rounded-xl border border-gray-200 p-6">
                <h3 class="text-lg font-semibold text-gray-800 mb-3">{{ item.question }}</h3>
                <p class="text-gray-600 text-sm">{{ item.answer }}</p>
            </div>
            {% endfor %}
        </div>
    </div>
</section>

