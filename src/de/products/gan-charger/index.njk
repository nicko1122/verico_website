---
title: GaN Ladegeräte Serie
lang: de
permalink: /de/products/gan-charger/
---

<!-- TEST ENVIRONMENT WARNING -->
<div class="bg-red-500 text-white text-center py-2 px-4">
  <strong>⚠️ TEST ENVIRONMENT ONLY - NOT FOR PRODUCTION USE ⚠️</strong>
</div>

<!-- Hero Section -->
<section class="relative w-full h-[400px]">
    <div class="hero-wrapper rounded-2xl border border-gray-200 mx-2 my-3 md:mx-4 md:my-4 overflow-hidden h-full">
        <div class="hero-container relative w-full h-full mx-auto">
            <img src="{{ products.de.hero.image }}" alt="{{ products.de.hero.alt }}"
                class="w-full h-full object-cover object-center" />
            <div class="absolute inset-0 bg-black/40 flex items-center justify-center">
                <h1 class="text-5xl font-bold text-white text-center px-6 py-4">
                    {{ products.de.hero.title | safe }}
                </h1>
            </div>
        </div>
    </div>
</section>

<!-- Products Grid -->
<section class="py-16">
    <div class="max-w-7xl mx-auto px-6">
        <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-8">
            {% for product in products.de.products.gan-charger %}
            <div class="bg-white border border-gray-200 rounded-2xl shadow-md overflow-hidden hover:shadow-lg transition-shadow">
                <div class="aspect-square bg-gray-50 p-6">
                    <img src="{{ product.image }}" alt="{{ product.alt }}" 
                         class="w-full h-full object-contain"
                         onerror="this.src='https://placehold.co/400x400?text=Image+Not+Found'; this.classList.add('opacity-60');">
                </div>
                <div class="p-6">
                    <h3 class="text-xl font-bold text-gray-800 mb-2">{{ product.name }}</h3>
                    <p class="text-gray-600 text-sm mb-3">{{ product.description }}</p>
                    <p class="text-gray-500 text-xs mb-4">{{ product.details }}</p>
                    <a href="{{ product.link }}" 
                       class="inline-block bg-gray-800 text-white px-6 py-2 rounded-lg text-sm font-medium hover:bg-gray-700 transition">
                        Details anzeigen
                    </a>
                </div>
            </div>
            {% endfor %}
        </div>
    </div>
</section> 