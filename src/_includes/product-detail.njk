<!-- Product Detail Template -->

<!-- Main Content -->
<main class="pt-16">
    <!-- Product Hero Section -->
    <section class="py-16">
        <div class="max-w-7xl mx-auto px-6">
            <div class="grid grid-cols-1 lg:grid-cols-2 gap-12 items-center min-h-[600px]">
                <!-- Product Image Carousel - 左半邊 -->
                <div class="w-full h-full flex items-center justify-center">
                    <div class="w-full max-w-lg aspect-square relative">
                        <!-- 主圖片 -->
                        <img id="main-carousel-image"
                             src="{{ product.hero.image }}"
                             alt="{{ product.hero.title }}"
                             class="w-full h-full object-cover cursor-zoom-in"
                             data-index="0"
                             onerror="this.src='https://placehold.co/600x600?text=Image+Not+Found'; this.classList.add('opacity-60');">
                        
                        <!-- Carousel Thumbnails -->
                        {% if product.hero.gallery %}
                        <div class="absolute bottom-4 left-1/2 -translate-x-1/2 flex gap-3 z-10">
                            {% for image in product.hero.gallery %}
                            <button class="carousel-thumb border-2 {% if loop.first %}border-gray-400{% else %}border-transparent{% endif %} rounded-lg overflow-hidden w-14 h-14 bg-white p-0.5 transition"
                                    data-index="{{ loop.index0 }}">
                                <img src="{{ image }}" alt="{{ product.hero.title }} Thumbnail" class="w-full h-full object-cover rounded-md"
                                     onerror="this.src='https://placehold.co/80x80?text=No+Img'; this.classList.add('opacity-60');">
                            </button>
                            {% endfor %}
                        </div>
                        {% endif %}
                    </div>
                    
                    <!-- Modal for image zoom -->
                    <div id="image-modal" class="fixed inset-0 bg-black/70 flex items-center justify-center z-[9999] hidden">
                        <div class="relative max-w-4xl w-full mx-4">
                            <button id="close-modal-btn" class="absolute -top-12 right-0 bg-white rounded-full p-3 shadow-lg hover:bg-gray-100 transition z-[10000]">
                                <svg class="w-6 h-6 text-gray-700" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12"/>
                                </svg>
                            </button>
                            <img id="modal-image" src="" alt="Zoomed Product Image" class="w-full h-auto rounded-xl shadow-lg bg-white object-contain max-h-[80vh]"
                                 onerror="this.src='https://placehold.co/800x600?text=Image+Not+Found';">
                        </div>
                    </div>
                    
                    {% if product.hero.gallery %}
                    <script>
                        document.addEventListener('DOMContentLoaded', function () {
                            // 圖片路徑陣列
                            const images = [
                                {% for image in product.hero.gallery %}
                                "{{ image }}"{% if not loop.last %},{% endif %}
                                {% endfor %}
                            ];
                            const mainImg = document.getElementById('main-carousel-image');
                            const thumbs = document.querySelectorAll('.carousel-thumb');
                            let currentIndex = 0;

                            // 檢查圖片是否載入失敗，若失敗則顯示預設圖
                            function checkImage(img, fallback) {
                                img.onerror = function() {
                                    img.src = fallback;
                                    img.classList.add('opacity-60');
                                };
                            }
                            checkImage(mainImg, 'https://placehold.co/600x600?text=Image+Not+Found');
                            thumbs.forEach(btn => {
                                const thumbImg = btn.querySelector('img');
                                checkImage(thumbImg, 'https://placehold.co/80x80?text=No+Img');
                            });

                            // 預設顯示第一張圖
                            function showImage(idx) {
                                currentIndex = idx;
                                mainImg.src = images[idx];
                                mainImg.setAttribute('data-index', idx);
                                thumbs.forEach(t => t.classList.remove('border-gray-400'));
                                thumbs[idx].classList.add('border-gray-400');
                            }

                            // 初始化顯示第一張圖
                            showImage(0);

                            // 縮圖點擊切換主圖
                            thumbs.forEach((btn, idx) => {
                                btn.addEventListener('click', function () {
                                    showImage(idx);
                                });
                            });

                            // 主圖點擊開啟modal
                            const modal = document.getElementById('image-modal');
                            const modalImg = document.getElementById('modal-image');
                            mainImg.addEventListener('click', function () {
                                modalImg.src = images[currentIndex];
                                modalImg.classList.remove('opacity-60'); // 確保移除半透明效果
                                modal.classList.remove('hidden');
                            });

                            // 關閉modal
                            document.getElementById('close-modal-btn').addEventListener('click', function () {
                                modal.classList.add('hidden');
                                modalImg.src = '';
                            });

                            // 點modal背景也可關閉
                            modal.addEventListener('click', function (e) {
                                if (e.target === modal) {
                                    modal.classList.add('hidden');
                                    modalImg.src = '';
                                }
                            });
                        });
                    </script>
                    {% endif %}
                </div>
                
                <!-- Product Info - 右半邊 -->
                <div class="w-full h-full flex items-center justify-center">
                    <div class="text-center lg:text-left max-w-lg bg-white rounded-2xl border border-gray-200 shadow-lg p-8">
                        <div class="mb-6">
                            <span class="bg-purple-500 text-white px-4 py-2 rounded-full text-sm font-medium">
                                {{ product.hero.badge }}
                            </span>
                        </div>
                        <h1 class="text-6xl font-bold text-gray-800 mb-6 leading-tight">{{ product.hero.title }}</h1>
                        <p class="text-xl text-gray-600 mb-8 leading-relaxed">
                            {{ product.hero.subtitle }}
                        </p>

                        <div class="flex gap-4 justify-center lg:justify-start">
                            <button class="border border-gray-300 text-gray-700 px-10 py-4 rounded-lg font-medium hover:bg-gray-50 transition text-lg">
                                Contact Sales
                            </button>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </section>

    <!-- Product Features Introduction -->
    {% if product.features %}
    <section class="py-16 bg-gray-50">
        <div class="max-w-5xl mx-auto px-6">
            <div class="text-center mb-12">
                <h2 class="text-3xl font-bold text-gray-800 mb-4">{{ product.features.section_title }}</h2>
                <p class="text-gray-600 max-w-2xl mx-auto">
                    {{ product.features.section_intro }}
                </p>
            </div>

            <div class="grid md:grid-cols-2 gap-8">
                {% for feature in product.features.items %}
                <div class="feature-card bg-white rounded-xl border border-gray-200 p-8">
                    <div class="flex items-start gap-6">
                        <div class="bg-purple-100 rounded-full p-4 flex-shrink-0">
                            <svg class="w-8 h-8 text-purple-600" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 10V3L4 14h7v7l9-11h-7z"></path>
                            </svg>
                        </div>
                        <div class="flex-1">
                            <h3 class="text-xl font-semibold text-gray-800 mb-3">{{ feature.title }}</h3>
                            <p class="text-gray-600 mb-4">
                                {{ feature.description }}
                            </p>
                            {% if feature.bullets %}
                            <div class="bg-gray-50 rounded-lg p-4 mb-4">
                                <h4 class="font-semibold text-gray-800 mb-2">Key Benefits:</h4>
                                <ul class="text-sm text-gray-600 space-y-1">
                                    {% for bullet in feature.bullets %}
                                    <li>• {{ bullet }}</li>
                                    {% endfor %}
                                </ul>
                            </div>
                            {% endif %}
                            {% if feature.image %}
                            <div class="mt-4">
                                <img src="{{ feature.image }}" alt="{{ feature.title }}" 
                                     class="w-full h-48 object-cover rounded-lg shadow-md"
                                     onerror="this.src='https://placehold.co/400x200?text=Feature+Image'; this.classList.add('opacity-60');">
                                <p class="text-xs text-gray-500 mt-2 text-center">{{ feature.title }} feature</p>
                            </div>
                            {% endif %}
                        </div>
                    </div>
                </div>
                {% endfor %}
            </div>
        </div>
    </section>
    {% endif %}

    <!-- Product Specifications -->
    {% if product.specifications %}
    <section class="py-16 bg-white">
        <div class="max-w-5xl mx-auto px-6">
            <div class="text-center mb-12">
                <h2 class="text-3xl font-bold text-gray-800 mb-4">{{ product.specifications.section_title }}</h2>
                <p class="text-gray-600 max-w-2xl mx-auto">
                    Detailed technical specifications and features of the {{ product.hero.title }}
                </p>
            </div>

            <div class="grid md:grid-cols-2 gap-8">
                <!-- Technical Specifications -->
                {% if product.specifications.technical %}
                <div class="spec-card bg-white rounded-xl border border-gray-200 p-6">
                    <h3 class="text-xl font-semibold text-gray-800 mb-6">Technical Specifications</h3>
                    <table class="spec-table w-full">
                        {% for spec in product.specifications.technical %}
                        <tr>
                            <td>{{ spec.label }}</td>
                            <td>{{ spec.value }}</td>
                        </tr>
                        {% endfor %}
                    </table>
                </div>
                {% endif %}

                <!-- Features -->
                {% if product.specifications.features %}
                <div class="spec-card bg-white rounded-xl border border-gray-200 p-6">
                    <h3 class="text-xl font-semibold text-gray-800 mb-6">Key Features</h3>
                    <div class="space-y-4">
                        {% for feature in product.specifications.features %}
                        <div class="flex items-start gap-3">
                            <div class="bg-green-100 rounded-full p-2 mt-1">
                                <svg class="w-4 h-4 text-green-600" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7"></path>
                                </svg>
                            </div>
                            <div>
                                <h4 class="font-semibold text-gray-800">{{ feature }}</h4>
                                <p class="text-sm text-gray-600">Advanced feature for optimal performance</p>
                            </div>
                        </div>
                        {% endfor %}
                    </div>
                </div>
                {% endif %}
            </div>
            
            {% if product.specifications.capacity_note %}
            <div class="mt-6 text-center">
                <p class="text-sm text-gray-500">{{ product.specifications.capacity_note }}</p>
            </div>
            {% endif %}
        </div>
    </section>
    {% endif %}

    <!-- Compatibility Section -->
    {% if product.compatibility %}
    <section class="py-16 bg-gray-50">
        <div class="max-w-5xl mx-auto px-6">
            <div class="text-center mb-12">
                <h2 class="text-3xl font-bold text-gray-800 mb-4">{{ product.compatibility.section_title }}</h2>
                <p class="text-gray-600 max-w-2xl mx-auto">
                    Compatible with a wide range of devices and charging protocols
                </p>
            </div>

            <div class="grid grid-cols-2 md:grid-cols-4 gap-6">
                {% for item in product.compatibility.items %}
                <div class="text-center">
                    <div class="bg-white rounded-full w-16 h-16 flex items-center justify-center mx-auto mb-4">
                        <svg class="w-8 h-8 text-gray-800" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 18h.01M8 21h8a2 2 0 002-2V5a2 2 0 00-2-2H8a2 2 0 00-2 2v14a2 2 0 002 2z"></path>
                        </svg>
                    </div>
                    <h3 class="font-semibold text-gray-800 mb-2">{{ item.label }}</h3>
                    <p class="text-sm text-gray-600">{{ item.note }}</p>
                </div>
                {% endfor %}
            </div>
        </div>
    </section>
    {% endif %}

    <!-- Package Contents -->
    {% if product.package %}
    <section class="py-16 bg-white">
        <div class="max-w-5xl mx-auto px-6">
            <div class="text-center mb-12">
                <h2 class="text-3xl font-bold text-gray-800 mb-4">{{ product.package.section_title }}</h2>
                <p class="text-gray-600 max-w-2xl mx-auto">
                    Everything you need to start using your {{ product.hero.title }} immediately
                </p>
            </div>

            <div class="grid md:grid-cols-3 gap-8">
                {% for item in product.package.items %}
                <div class="text-center">
                    <div class="bg-gray-100 rounded-lg p-6 mb-4">
                        <svg class="w-12 h-12 text-gray-600 mx-auto mb-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 3v2m6-2v2M9 19v2m6-2v2M5 9H3m2 6H3m18-6h-2m2 6h-2M7 19h10a2 2 0 002-2V7a2 2 0 00-2-2H7a2 2 0 00-2 2v10a2 2 0 002 2zM9 9h6v6H9V9z"></path>
                        </svg>
                    </div>
                    <h3 class="font-semibold text-gray-800 mb-2">{{ item.name }}</h3>
                    <p class="text-sm text-gray-600">{{ item.description }}</p>
                </div>
                {% endfor %}
            </div>
        </div>
    </section>
    {% endif %}

    <!-- Product Info Section -->
    {% if product.product_info %}
    <section class="py-8 bg-gray-50">
        <div class="max-w-5xl mx-auto px-6">
            <div class="bg-white rounded-2xl p-6 shadow-md">
                <div class="grid grid-cols-1 md:grid-cols-3 gap-6 text-center">
                    {% if product.product_info.model_name %}
                    <div>
                        <h3 class="text-sm font-medium text-gray-500 mb-1">Model Name</h3>
                        <p class="text-gray-900">{{ product.product_info.model_name }}</p>
                    </div>
                    {% endif %}
                    {% if product.product_info.sku %}
                    <div>
                        <h3 class="text-sm font-medium text-gray-500 mb-1">SKU</h3>
                        <p class="text-gray-900">{{ product.product_info.sku }}</p>
                    </div>
                    {% endif %}
                    {% if product.product_info.ean %}
                    <div>
                        <h3 class="text-sm font-medium text-gray-500 mb-1">EAN</h3>
                        <p class="text-gray-900">{{ product.product_info.ean }}</p>
                    </div>
                    {% endif %}
                </div>
            </div>
        </div>
    </section>
    {% endif %}
</main>

<!-- 產品規格頁面樣式 -->
<style>
    .spec-card {
        transition: all 0.3s ease;
    }
    
    .spec-card:hover {
        transform: translateY(-2px);
        box-shadow: 0 10px 25px -5px rgba(0, 0, 0, 0.1);
    }
    
    .product-image {
        transition: transform 0.3s ease;
    }
    
    .product-image:hover {
        transform: scale(1.05);
    }
    
    .spec-table {
        border-collapse: separate;
        border-spacing: 0;
    }
    
    .spec-table tr {
        border-bottom: 1px solid #e5e7eb;
    }
    
    .spec-table tr:last-child {
        border-bottom: none;
    }
    
    .spec-table td {
        padding: 12px 16px;
    }
    
    .spec-table td:first-child {
        font-weight: 600;
        color: #374151;
        width: 40%;
    }
    
    .spec-table td:last-child {
        color: #6b7280;
    }
    
    /* 產品圖片輪播樣式 */
    .product-carousel {
        position: relative;
        overflow: hidden;
        border-radius: 12px;
    }
    
    .carousel-slide {
        position: absolute;
        top: 0;
        left: 0;
        width: 100%;
        height: 100%;
        opacity: 0;
        transition: opacity 0.5s ease-in-out;
    }
    
    .carousel-slide.active {
        opacity: 1;
    }
</style> 