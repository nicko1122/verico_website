<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>{{ title }} - Verico</title>

<!-- Meta tags -->
<meta name="description" content="{{ description or 'Verico - Professional Power Solutions' }}">
<meta name="keywords" content="{{ keywords or 'power solutions, gan charger, energy products' }}">
<meta name="author" content="Verico">

<!-- Open Graph / Facebook -->
<meta property="og:type" content="website">
<meta property="og:url" content="{{ site.url }}{{ page.url }}">
<meta property="og:title" content="{{ title }} - Verico">
<meta property="og:description" content="{{ description or 'Verico - Professional Power Solutions' }}">
<meta property="og:image" content="{{ site.url }}/assets/images/verico-logo.png">

<!-- Twitter -->
<meta property="twitter:card" content="summary_large_image">
<meta property="twitter:url" content="{{ site.url }}{{ page.url }}">
<meta property="twitter:title" content="{{ title }} - Verico">
<meta property="twitter:description" content="{{ description or 'Verico - Professional Power Solutions' }}">
<meta property="twitter:image" content="{{ site.url }}/assets/images/verico-logo.png">

<!-- Favicon -->
<link rel="icon" type="image/x-icon" href="/assets/images/favicon.ico">
<link rel="apple-touch-icon" sizes="180x180" href="/assets/images/apple-touch-icon.png">
<link rel="icon" type="image/png" sizes="32x32" href="/assets/images/favicon-32x32.png">
<link rel="icon" type="image/png" sizes="16x16" href="/assets/images/favicon-16x16.png">

<!-- CSS -->
<link href="/assets/css/tailwind.css" rel="stylesheet">
<link href="/assets/css/main.css" rel="stylesheet">

<!-- Fonts -->
<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700&display=swap" rel="stylesheet">
<link href="https://fonts.googleapis.com/css2?family=Anton&display=swap" rel="stylesheet">

<!-- Custom styles to override Tailwind -->
<style>
  /* Enhanced glass morphism for navigation dropdowns */
  .dropdown-menu {
    background: rgba(255, 255, 255, 0.85) !important;
    backdrop-filter: blur(20px) !important;
    -webkit-backdrop-filter: blur(20px) !important;
    border: 1px solid rgba(255, 255, 255, 0.3) !important;
    box-shadow: 0 8px 32px rgba(0, 0, 0, 0.1) !important;
  }

  .submenu {
    background: rgba(255, 255, 255, 0.85) !important;
    backdrop-filter: blur(20px) !important;
    -webkit-backdrop-filter: blur(20px) !important;
    border: 1px solid rgba(255, 255, 255, 0.3) !important;
    box-shadow: 0 8px 32px rgba(0, 0, 0, 0.1) !important;
  }

  /* Test glass effect */
  .glass-test {
    background: rgba(255, 255, 255, 0.9) !important;
    backdrop-filter: blur(15px) !important;
    -webkit-backdrop-filter: blur(15px) !important;
    border: 1px solid rgba(255, 255, 255, 0.2) !important;
  }

  /* Fallback for browsers that don't support backdrop-filter */
  @supports not (backdrop-filter: blur(1px)) {
    .dropdown-menu,
    .submenu {
      background: rgba(255, 255, 255, 0.95) !important;
    }
  }

  /* Debug styles - make dropdowns more visible */
  .dropdown-menu {
    background: rgba(255, 255, 255, 0.9) !important;
    backdrop-filter: blur(25px) !important;
    -webkit-backdrop-filter: blur(25px) !important;
    border: 2px solid rgba(255, 255, 255, 0.5) !important;
    box-shadow: 0 12px 40px rgba(0, 0, 0, 0.15) !important;
  }

  .submenu {
    background: rgba(255, 255, 255, 0.9) !important;
    backdrop-filter: blur(25px) !important;
    -webkit-backdrop-filter: blur(25px) !important;
    border: 2px solid rgba(255, 255, 255, 0.5) !important;
    box-shadow: 0 12px 40px rgba(0, 0, 0, 0.15) !important;
  }

  /* Ensure opacity classes work with glass effect */
  .dropdown-menu.opacity-100,
  .submenu.opacity-100 {
    backdrop-filter: blur(25px) !important;
    -webkit-backdrop-filter: blur(25px) !important;
  }

  /* Ensure clickable elements are accessible */
  .dropdown-menu a,
  .submenu a {
    cursor: pointer !important;
    pointer-events: auto !important;
    position: relative !important;
    z-index: 50 !important;
  }

  /* Ensure dropdowns are clickable when visible */
  .dropdown-menu.opacity-100,
  .submenu.opacity-100 {
    pointer-events: auto !important;
    cursor: pointer !important;
  }

  /* Prevent text selection on hover */
  .dropdown-menu,
  .submenu {
    user-select: none !important;
    -webkit-user-select: none !important;
    -moz-user-select: none !important;
    -ms-user-select: none !important;
  }

  /* Ensure all navigation links are clickable */
  .dropdown-menu li,
  .submenu li {
    pointer-events: auto !important;
  }

  /* Remove any potential click blockers */
  .dropdown-menu *,
  .submenu * {
    pointer-events: auto !important;
  }

  /* Ensure proper z-index for clickable elements */
  .dropdown-menu a,
  .submenu a {
    z-index: 50 !important;
    position: relative !important;
  }

  /* Fix for any potential overlay issues */
  .dropdown-menu::before,
  .submenu::before {
    display: none !important;
  }

  .dropdown-menu::after,
  .submenu::after {
    display: none !important;
  }

  /* Ensure submenu has higher z-index */
  .submenu {
    z-index: 70 !important;
  }

  /* Ensure all links in submenu are clickable */
  .submenu a {
    z-index: 80 !important;
    pointer-events: auto !important;
    cursor: pointer !important;
  }

  /* Force pointer events on all menu items */
  .dropdown-menu li a,
  .submenu li a {
    pointer-events: auto !important;
    cursor: pointer !important;
    z-index: 100 !important;
  }

  /* Pure CSS Dropdown Implementation */
  .dropdown-container {
    position: relative;
  }

  .dropdown-menu {
    position: absolute;
    top: 100%;
    left: 0;
    opacity: 0;
    visibility: hidden;
    transform: translateY(-10px);
    transition: all 0.2s ease;
    pointer-events: none;
  }

  .dropdown-container:hover .dropdown-menu {
    opacity: 1;
    visibility: visible;
    transform: translateY(0);
    pointer-events: auto;
  }

  .submenu-item {
    position: relative;
  }

  .submenu {
    position: absolute;
    top: 0;
    left: 100%;
    opacity: 0;
    visibility: hidden;
    transform: translateX(-10px);
    transition: all 0.2s ease;
    pointer-events: none;
  }

  .submenu-item:hover .submenu {
    opacity: 1;
    visibility: visible;
    transform: translateX(0);
    pointer-events: auto;
  }

  /* Ensure proper spacing and positioning */
  .dropdown-menu {
    margin-top: 0.5rem;
    min-width: 200px;
  }

  .submenu {
    margin-left: 0.5rem;
    min-width: 180px;
  }

  /* Mobile styles - hide CSS dropdowns on mobile */
  @media (max-width: 767px) {
    .dropdown-container:hover .dropdown-menu,
    .submenu-item:hover .submenu {
      opacity: 0;
      visibility: hidden;
      pointer-events: none;
    }
  }
</style>

<!-- Tailwind CSS -->
<script src="https://cdn.tailwindcss.com"></script>
<script>
    tailwind.config = {
        theme: {
            extend: {
                fontFamily: {
                    'sans': ['Inter', 'ui-sans-serif', 'system-ui'],
                    'anton': ['Anton', 'sans-serif'],
                }
            }
        }
    }
</script>

<!-- Hero 靜態圖片樣式 -->
<style>
    .hero-wrapper {
        position: relative;
        height: 100%;
        width: 100%;
        max-width: 100%;
        overflow: hidden;
    }
    
    .hero-container {
        border-radius: inherit;
        width: 95%;
        height: 100%;
        margin: 0 auto;
    }
    
    .hero-container img {
        border-radius: inherit;
        max-width: 100%;
        max-height: 100%;
    }
</style>

<!-- Additional meta tags -->
<meta name="robots" content="index, follow">
<meta name="language" content="{{ lang }}">
<meta name="revisit-after" content="7 days">
<meta name="distribution" content="global"> 