<!-- Product Hero Section -->
<section class="py-16">
    <div class="max-w-7xl mx-auto px-6">
        <div class="grid grid-cols-1 lg:grid-cols-2 gap-12 items-center min-h-[600px]">
            <!-- Product Image Carousel - Left Side -->
            <div class="w-full h-full flex items-center justify-center">
                <div class="w-full max-w-lg aspect-square relative">
                    <!-- Main Image -->
                    <img id="main-carousel-image"
                         src="https://placehold.co/600x600?text={{ product.name | replace(' ', '+') }}"
                         alt="{{ product.name }} - Front View"
                         class="w-full h-full object-cover cursor-zoom-in"
                         data-index="0">
                    
                    <!-- Carousel Thumbnails -->
                    <div class="absolute bottom-4 left-1/2 -translate-x-1/2 flex gap-3 z-10">
                        {% for i in range(1, 5) %}
                        <button class="carousel-thumb border-2 {% if i == 1 %}border-gray-400{% else %}border-transparent{% endif %} rounded-lg overflow-hidden w-14 h-14 bg-white p-0.5 transition"
                                data-index="{{ i - 1 }}">
                            <img src="https://placehold.co/80x80?text={{ product.name | replace(' ', '+') }}+{{ i }}" alt="Product View {{ i }} Thumbnail" class="w-full h-full object-cover rounded-md">
                        </button>
                        {% endfor %}
                    </div>
                </div>
                
                <!-- Modal for image zoom -->
                <div id="image-modal" class="fixed inset-0 bg-black/70 flex items-center justify-center z-[9999] hidden">
                    <div class="relative max-w-4xl w-full mx-4">
                        <button id="close-modal-btn" class="absolute -top-12 right-0 bg-white rounded-full p-3 shadow-lg hover:bg-gray-100 transition z-[10000]">
                            <svg class="w-6 h-6 text-gray-700" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12"/>
                            </svg>
                        </button>
                        <img id="modal-image" src="" alt="Zoomed Product Image" class="w-full h-auto rounded-xl shadow-lg bg-white object-contain max-h-[80vh]">
                    </div>
                </div>
            </div>
            
            <!-- Product Info - Right Side -->
            <div class="w-full h-full flex items-center justify-center">
                <div class="text-center lg:text-left max-w-lg bg-white rounded-2xl border border-gray-200 shadow-lg p-8">
                    <div class="mb-6">
                        <span class="bg-purple-500 text-white px-4 py-2 rounded-full text-sm font-medium">
                            {{ product.series }}
                        </span>
                    </div>
                    <h1 class="text-6xl font-bold text-gray-800 mb-6 leading-tight">{{ product.name }}</h1>
                    <p class="text-xl text-gray-600 mb-8 leading-relaxed">
                        {{ product.description }}
                    </p>

                    <div class="flex gap-4 justify-center lg:justify-start">
                        <a href="/{{ lang }}/contact/" class="border border-gray-300 text-gray-700 px-10 py-4 rounded-lg font-medium hover:bg-gray-50 transition text-lg">
                            Contact Sales
                        </a>
                    </div>
                </div>
            </div>
        </div>
    </div>
</section>

<!-- Product Features Introduction -->
<section class="py-16 bg-gray-50">
    <div class="max-w-5xl mx-auto px-6">
        <div class="text-center mb-12">
            <h2 class="text-3xl font-bold text-gray-800 mb-4">{{ product.features.title }}</h2>
            <p class="text-gray-600 max-w-2xl mx-auto">
                {{ product.features.description }}
            </p>
        </div>

        <div class="grid md:grid-cols-2 gap-8 mb-16">
            {% for feature in product.features.items %}
            <div class="feature-card bg-white rounded-xl border border-gray-200 p-8">
                <div class="flex items-start gap-6">
                    <div class="bg-blue-100 rounded-full p-3">
                        <svg class="w-8 h-8 text-blue-600" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="{{ feature.icon }}"/>
                        </svg>
                    </div>
                    <div class="flex-1">
                        <h3 class="text-xl font-semibold text-gray-800 mb-3">{{ feature.title }}</h3>
                        <p class="text-gray-600 leading-relaxed">{{ feature.description }}</p>
                    </div>
                </div>
            </div>
            {% endfor %}
        </div>
    </div>
</section>

<!-- Product Specifications -->
<section class="py-16 bg-white">
    <div class="max-w-5xl mx-auto px-6">
        <div class="text-center mb-12">
            <h2 class="text-3xl font-bold text-gray-800 mb-4">{{ product.specs.title }}</h2>
            <p class="text-gray-600 max-w-2xl mx-auto">
                {{ product.specs.description }}
            </p>
        </div>

        <div class="grid md:grid-cols-2 gap-8">
            {% for spec_group in product.specs.groups %}
            <div class="spec-card bg-white rounded-xl border border-gray-200 p-8">
                <h3 class="text-xl font-semibold text-gray-800 mb-6">{{ spec_group.title }}</h3>
                <table class="spec-table w-full">
                    {% for spec in spec_group.items %}
                    <tr>
                        <td>{{ spec.name }}</td>
                        <td>{{ spec.value }}</td>
                    </tr>
                    {% endfor %}
                </table>
            </div>
            {% endfor %}
        </div>
    </div>
</section>

<!-- Product Benefits -->
<section class="py-16 bg-gray-50">
    <div class="max-w-5xl mx-auto px-6">
        <div class="text-center mb-12">
            <h2 class="text-3xl font-bold text-gray-800 mb-4">{{ product.benefits.title }}</h2>
            <p class="text-gray-600 max-w-2xl mx-auto">
                {{ product.benefits.description }}
            </p>
        </div>

        <div class="grid md:grid-cols-3 gap-8">
            {% for benefit in product.benefits.items %}
            <div class="benefit-card bg-white rounded-xl border border-gray-200 p-8 text-center">
                <div class="bg-green-100 rounded-full w-16 h-16 flex items-center justify-center mx-auto mb-6">
                    <svg class="w-8 h-8 text-green-600" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="{{ benefit.icon }}"/>
                    </svg>
                </div>
                <h3 class="text-xl font-semibold text-gray-800 mb-4">{{ benefit.title }}</h3>
                <p class="text-gray-600 leading-relaxed">{{ benefit.description }}</p>
            </div>
            {% endfor %}
        </div>
    </div>
</section>

<!-- Call to Action -->
<section class="py-16 bg-white">
    <div class="max-w-4xl mx-auto px-6 text-center">
        <h2 class="text-3xl font-bold text-gray-800 mb-6">{{ product.cta.title }}</h2>
        <p class="text-gray-600 mb-8 max-w-2xl mx-auto">
            {{ product.cta.description }}
        </p>
        <div class="flex gap-4 justify-center">
            <a href="/{{ lang }}/contact/" class="bg-blue-600 text-white px-8 py-4 rounded-lg font-medium hover:bg-blue-700 transition text-lg">
                {{ product.cta.primary_button }}
            </a>
            <a href="/{{ lang }}/products/" class="border border-gray-300 text-gray-700 px-8 py-4 rounded-lg font-medium hover:bg-gray-50 transition text-lg">
                {{ product.cta.secondary_button }}
            </a>
        </div>
    </div>
</section>

<!-- Product Carousel JavaScript -->
<script>
document.addEventListener('DOMContentLoaded', function () {
    // 圖片路徑陣列
    const images = [
        "https://placehold.co/600x600?text={{ product.name | replace(' ', '+') }}+1",
        "https://placehold.co/600x600?text={{ product.name | replace(' ', '+') }}+2",
        "https://placehold.co/600x600?text={{ product.name | replace(' ', '+') }}+3",
        "https://placehold.co/600x600?text={{ product.name | replace(' ', '+') }}+4"
    ];
    
    const mainImage = document.getElementById('main-carousel-image');
    const modalImage = document.getElementById('modal-image');
    const imageModal = document.getElementById('image-modal');
    const closeModalBtn = document.getElementById('close-modal-btn');
    const thumbs = document.querySelectorAll('.carousel-thumb');
    
    let currentIndex = 0;
    
    // 更新主圖片
    function updateMainImage(index) {
        mainImage.src = images[index];
        mainImage.setAttribute('data-index', index);
        currentIndex = index;
        
        // 更新縮圖邊框
        thumbs.forEach((thumb, i) => {
            if (i === index) {
                thumb.classList.add('border-gray-400');
                thumb.classList.remove('border-transparent');
            } else {
                thumb.classList.remove('border-gray-400');
                thumb.classList.add('border-transparent');
            }
        });
    }
    
    // 縮圖點擊事件
    thumbs.forEach((thumb, index) => {
        thumb.addEventListener('click', () => {
            updateMainImage(index);
        });
    });
    
    // 主圖片點擊放大
    mainImage.addEventListener('click', () => {
        modalImage.src = images[currentIndex];
        imageModal.classList.remove('hidden');
        document.body.style.overflow = 'hidden';
    });
    
    // 關閉模態框
    closeModalBtn.addEventListener('click', () => {
        imageModal.classList.add('hidden');
        document.body.style.overflow = '';
    });
    
    // 點擊模態框背景關閉
    imageModal.addEventListener('click', (e) => {
        if (e.target === imageModal) {
            imageModal.classList.add('hidden');
            document.body.style.overflow = '';
        }
    });
    
    // ESC 鍵關閉模態框
    document.addEventListener('keydown', (e) => {
        if (e.key === 'Escape' && !imageModal.classList.contains('hidden')) {
            imageModal.classList.add('hidden');
            document.body.style.overflow = '';
        }
    });
});
</script> 