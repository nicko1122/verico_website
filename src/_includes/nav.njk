<header class="fixed top-0 left-0 right-0 z-50">
    <!-- Desktop Navigation -->
    <div class="hidden md:flex justify-center w-full">
        <nav class="mt-8 mx-auto w-[92%] max-w-5xl rounded-2xl bg-white/60 backdrop-blur-xl shadow-lg border border-gray-200 flex items-center px-6 py-2 relative">
            <a href="/{{ lang }}/" class="flex items-center mr-8">
                <img src="{{ ('/' + site[lang].logo) | url }}" alt="Verico Logo" style="height: 44px;" class="block" />
            </a>
            <div class="hidden md:flex flex-1 justify-center">
                <div class="flex gap-8">
                    {% for item in navigation[lang].main %}
                        {% if item.submenu %}
                        <div class="relative group" id="products-dropdown">
                            <a href="{{ item.url }}" class="text-sm font-medium text-gray-700 hover:text-gray-900 transition flex items-center gap-1">
                                {{ item.title }}
                                <svg class="w-4 h-4 text-gray-400" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 20 20">
                                    <path stroke-linecap="round" stroke-linejoin="round" d="M6 8l4 4 4-4"/>
                                </svg>
                            </a>
                            <div class="relative">
                                <div class="dropdown-menu absolute left-0 top-full mt-2 min-w-[180px] bg-white/80 border border-gray-200 rounded-xl shadow-lg opacity-0 pointer-events-none transition-opacity z-40" style="backdrop-filter: blur(12px);">
                                    <ul class="py-2">
                                        {% for subitem in item.submenu %}
                                            <li class="relative submenu-item">
                                                <a href="{{ subitem.url }}" class="block px-5 py-2 text-sm text-gray-700 hover:bg-gray-100 flex items-center justify-between">
                                                    {{ subitem.title }}
                                                    {% if subitem.submenu %}
                                                    <svg class="w-3 h-3 ml-1 text-gray-400" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 20 20">
                                                        <path stroke-linecap="round" stroke-linejoin="round" d="M6 8l4 4 4-4"/>
                                                    </svg>
                                                    {% endif %}
                                                </a>
                                                {% if subitem.submenu %}
                                                <ul class="submenu absolute left-full top-0 mt-0 min-w-[160px] bg-white/80 border border-gray-200 rounded-xl shadow-lg opacity-0 pointer-events-none transition-opacity z-50" style="backdrop-filter: blur(12px);">
                                                    {% for sub_subitem in subitem.submenu %}
                                                    <li>
                                                        <a href="{{ sub_subitem.url }}" class="block px-5 py-2 text-sm text-gray-700 hover:bg-gray-100">{{ sub_subitem.title }}</a>
                                                    </li>
                                                    {% endfor %}
                                                </ul>
                                                {% endif %}
                                            </li>
                                        {% endfor %}
                                    </ul>
                                </div>
                            </div>
                        </div>
                        {% else %}
                        <a href="{{ item.url }}" class="text-sm font-medium text-gray-700 hover:text-gray-900 transition">{{ item.title }}</a>
                        {% endif %}
                    {% endfor %}
                </div>
            </div>
            <div class="hidden md:flex items-center gap-4 ml-8">
                <!-- Language Selector -->
                {% set slug = '' if page.fileSlug == 'en' or page.fileSlug == 'de' else page.fileSlug %}
                <select onchange="location = this.value;" class="bg-transparent border border-gray-300 rounded-md px-2 py-1 text-sm text-gray-700 focus:outline-none focus:ring-1 focus:ring-gray-400 w-28" style="min-width: 112px;">
                    <option value="/en/{% if slug %}{{ slug }}/{% endif %}" {% if lang == 'en' %}selected{% endif %}>English</option>
                    <option value="/de/{% if slug %}{{ slug }}/{% endif %}" {% if lang == 'de' %}selected{% endif %}>Deutsch</option>
                </select>
            </div>
        </nav>
    </div>
    
    <!-- Mobile Navigation -->
    <div class="md:hidden flex justify-center w-full">
         <nav class="mt-4 mx-auto w-[92%] max-w-5xl rounded-2xl bg-white/60 backdrop-blur-xl shadow-lg border border-gray-200 flex items-center px-6 py-2 relative">
            <button id="mobile-menu-button" class="flex items-center justify-center mr-4 p-2 rounded-md focus:outline-none focus:ring-2 focus:ring-gray-300 bg-white/40 backdrop-blur-xl border border-gray-200" aria-label="Open main menu">
                <svg class="w-7 h-7 text-gray-700" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" d="M4 7h16M4 12h16M4 17h16"/>
                </svg>
            </button>
            <a href="/{{ lang }}/" class="flex items-center">
                <img src="{{ ('/' + site[lang].logo) | url }}" alt="Verico Logo" style="height: 44px;" class="block" />
            </a>
        </nav>
    </div>
    
    <!-- Mobile Nav Drawer -->
    <div id="mobile-nav-drawer" class="fixed top-0 left-0 h-full w-full bg-white/30 backdrop-blur-xl border-none shadow-lg z-[60] transform -translate-x-full transition-transform duration-200 ease-in-out md:hidden">
        <div class="flex flex-col h-full w-64 bg-white/30 backdrop-blur-xl border-r border-gray-200 shadow-lg">
            <div class="flex items-center justify-between px-6 py-4 border-b border-gray-100">
                <a href="/{{ lang }}/" class="flex items-center">
                    <img src="{{ ('/' + site[lang].logo) | url }}" alt="Verico Logo" style="height: 36px;" class="block" />
                </a>
                <button id="mobile-nav-close" class="p-2 rounded-md focus:outline-none focus:ring-2 focus:ring-gray-300" aria-label="Close menu">
                    <svg class="w-6 h-6 text-gray-700" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
                        <path stroke-linecap="round" stroke-linejoin="round" d="M6 18L18 6M6 6l12 12"/>
                    </svg>
                </button>
            </div>
            <nav class="flex-1 flex flex-col gap-2 px-6 py-6">
                {% for item in navigation[lang].main %}
                    {% if item.submenu %}
                    <div class="block">
                        <button class="flex items-center w-full text-base font-medium text-gray-700 py-2 focus:outline-none mobile-menu-toggle">
                            {{ item.title }}
                            <svg class="w-4 h-4 ml-1 text-gray-400" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 20 20">
                                <path stroke-linecap="round" stroke-linejoin="round" d="M6 8l4 4 4-4"/>
                            </svg>
                        </button>
                        <div class="mobile-submenu hidden flex-col pl-4 mt-1">
                            {% for subitem in item.submenu %}
                                <a href="{{ subitem.url }}" class="block text-sm text-gray-700 py-2">{{ subitem.title }}</a>
                                {% if subitem.submenu %}
                                <div class="pl-2">
                                    <button class="flex items-center w-full text-sm text-gray-700 py-1 focus:outline-none mobile-menu-toggle">
                                        {{ subitem.title }} Models
                                        <svg class="w-3 h-3 ml-1 text-gray-400" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 20 20">
                                            <path stroke-linecap="round" stroke-linejoin="round" d="M6 8l4 4 4-4"/>
                                        </svg>
                                    </button>
                                    <div class="mobile-submenu hidden flex-col pl-4 mt-1">
                                        {% for sub_subitem in subitem.submenu %}
                                        <a href="{{ sub_subitem.url }}" class="block text-xs text-gray-700 py-1">{{ sub_subitem.title }}</a>
                                        {% endfor %}
                                    </div>
                                </div>
                                {% endif %}
                            {% endfor %}
                        </div>
                    </div>
                    {% else %}
                    <a href="{{ item.url }}" class="block text-base font-medium text-gray-700 py-2">{{ item.title }}</a>
                    {% endif %}
                {% endfor %}
            </nav>
            {% set slug = '' if page.fileSlug == 'en' or page.fileSlug == 'de' else page.fileSlug %}
            <div class="px-6 pb-6">
                <select onchange="location = this.value;" class="bg-transparent border border-gray-300 rounded-md px-2 py-1 text-sm text-gray-700 focus:outline-none focus:ring-1 focus:ring-gray-400 w-full" style="min-width: 112px;">
                    <option value="/en/{% if slug %}{{ slug }}/{% endif %}" {% if lang == 'en' %}selected{% endif %}>English</option>
                    <option value="/de/{% if slug %}{{ slug }}/{% endif %}" {% if lang == 'de' %}selected{% endif %}>Deutsch</option>
                </select>
            </div>
        </div>
    </div>
    <!-- Overlay for mobile nav -->
    <div id="mobile-nav-overlay" class="fixed inset-0 bg-black/20 z-[55] hidden md:hidden"></div>
</header>
<script>
document.addEventListener('DOMContentLoaded', function() {
    // Desktop dropdown
    function isDesktop() {
        return window.innerWidth >= 768;
    }
    const dropdown = document.getElementById('products-dropdown');
    if (dropdown) {
        const dropdownMenu = dropdown.querySelector('.dropdown-menu');
        const submenuItems = dropdown.querySelectorAll('.submenu-item');
        let hideTimeout;

        function showDropdown() {
            if (!isDesktop()) return;
            clearTimeout(hideTimeout);
            dropdownMenu.classList.add('opacity-100', 'pointer-events-auto');
        }
        function hideDropdown() {
            if (!isDesktop()) return;
            hideTimeout = setTimeout(() => {
                dropdownMenu.classList.remove('opacity-100', 'pointer-events-auto');
                submenuItems.forEach(item => {
                    const submenu = item.querySelector('.submenu');
                    if (submenu) submenu.classList.remove('opacity-100', 'pointer-events-auto');
                });
            }, 100);
        }
        dropdown.addEventListener('mouseenter', showDropdown);
        dropdown.addEventListener('mouseleave', hideDropdown);
        submenuItems.forEach(item => {
            const submenu = item.querySelector('.submenu');
            if(submenu){
                item.addEventListener('mouseenter', () => {
                    if (!isDesktop()) return;
                    clearTimeout(hideTimeout);
                    submenu.classList.add('opacity-100', 'pointer-events-auto');
                });
                item.addEventListener('mouseleave', () => {
                    if (!isDesktop()) return;
                    submenu.classList.remove('opacity-100', 'pointer-events-auto');
                });
            }
        });
    }

    // Mobile nav drawer
    const menuBtn = document.getElementById('mobile-menu-button');
    const drawer = document.getElementById('mobile-nav-drawer');
    const overlay = document.getElementById('mobile-nav-overlay');
    const closeBtn = document.getElementById('mobile-nav-close');
    
    function openDrawer() {
        if(drawer) drawer.classList.remove('-translate-x-full');
        if(overlay) overlay.classList.remove('hidden');
        document.body.classList.add('overflow-hidden');
    }
    function closeDrawer() {
        if(drawer) drawer.classList.add('-translate-x-full');
        if(overlay) overlay.classList.add('hidden');
        document.body.classList.remove('overflow-hidden');
    }
    if(menuBtn) menuBtn.addEventListener('click', openDrawer);
    if(closeBtn) closeBtn.addEventListener('click', closeDrawer);
    if(overlay) overlay.addEventListener('click', closeDrawer);

    // Mobile submenu toggles
    const mobileMenuToggles = document.querySelectorAll('.mobile-menu-toggle');
    mobileMenuToggles.forEach(toggle => {
        toggle.addEventListener('click', function() {
            const submenu = this.nextElementSibling;
            if (submenu && submenu.classList.contains('mobile-submenu')) {
                submenu.classList.toggle('hidden');
            }
        });
    });
});
</script>

