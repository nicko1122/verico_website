<header class="fixed top-0 left-0 right-0 z-50">
  <nav class="mt-4 md:mt-8 mx-auto w-[92%] max-w-5xl rounded-2xl bg-white/60 backdrop-blur-xl shadow-lg border border-gray-200 flex items-center px-6 py-2 relative">
    <a href="/{{ lang }}/" class="flex items-center mr-8">
      <img src="{{ ('/' + site[lang].logo) | url }}" alt="Verico Logo" style="height: 44px;" class="block" />
    </a>

    <ul class="flex-1 flex items-center justify-center gap-6">
      {% for item in navigation[lang].main %}
        {% set isProducts = (item.title == 'Products' or item.title == 'Produkte') %}
        {% if isProducts %}
        <li class="relative">
          <details class="relative">
            <summary class="list-none cursor-pointer text-sm font-medium text-gray-700 hover:text-gray-900 flex items-center gap-1">
              {{ item.title }}
              <svg class="w-4 h-4 text-gray-400" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 20 20"><path stroke-linecap="round" stroke-linejoin="round" d="M6 8l4 4 4-4"/></svg>
            </summary>
            <ul class="nav-dd min-w-[240px] bg-white/90 border border-gray-200 rounded-xl shadow-lg z-40 p-1" style="backdrop-filter: blur(12px);">
              {% for tab in products[lang].categories.tabs %}
                {% set groupKey = tab.id | replace('-', '_') %}
                {% set group = products[lang].categories[groupKey] %}
                <li class="relative">
                  {% if group and group.products and group.products.length %}
                  <details class="relative submenu">
                    <summary class="list-none cursor-pointer flex items-center justify-between px-5 py-2 text-sm text-gray-700 hover:bg-gray-100">
                      <a href="{{ item.url }}#{{ tab.id }}" class="flex-1 text-left">{{ tab.title }}</a>
                      <svg class="w-3 h-3 ml-2 text-gray-400" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 20 20"><path stroke-linecap="round" stroke-linejoin="round" d="M6 8l4 4 4-4"/></svg>
                    </summary>
                    <ul class="submenu-dd bg-white/90 border border-gray-200 rounded-lg shadow-md p-1" style="backdrop-filter: blur(12px);">
                      {% for p in group.products %}
                        {% if p.url and p.url != '#' %}
                        <li>
                          <a href="{{ p.url }}" class="block px-5 py-2 text-sm text-gray-700 hover:bg-gray-100">{{ p.name }}</a>
                        </li>
                        {% endif %}
                      {% endfor %}
                    </ul>
                  </details>
                  {% else %}
                  <a href="{{ item.url }}#{{ tab.id }}" class="block px-5 py-2 text-sm text-gray-700 hover:bg-gray-100">{{ tab.title }}</a>
                  {% endif %}
                </li>
              {% endfor %}
            </ul>
          </details>
        </li>
        {% else %}
        <li>
          <a href="{{ item.url }}" class="text-sm font-medium text-gray-700 hover:text-gray-900">{{ item.title }}</a>
        </li>
        {% endif %}
      {% endfor %}
    </ul>

    <div class="flex items-center gap-4 ml-4">
      {% set slug = '' if page.fileSlug == 'en' or page.fileSlug == 'de' else page.fileSlug %}
      <select onchange="location = this.value;" class="bg-transparent border border-gray-300 rounded-md px-2 py-1 text-sm text-gray-700 focus:outline-none focus:ring-1 focus:ring-gray-400 w-28" style="min-width: 112px;">
        <option value="/en/{% if slug %}{{ slug }}/{% endif %}" {% if lang == 'en' %}selected{% endif %}>English</option>
        <option value="/de/{% if slug %}{{ slug }}/{% endif %}" {% if lang == 'de' %}selected{% endif %}>Deutsch</option>
      </select>
    </div>
  </nav>

  <style>
    /* Remove default marker from details summary for consistent styling */
    summary::-webkit-details-marker { display: none; }
    summary { outline: none; }
    /* Prevent details content from stretching parent nav height */
    .nav-dd { position: absolute; left: 0; top: 100%; margin-top: 0.5rem; }
    .submenu { position: relative; }
    .submenu-dd { position: absolute; left: 100%; top: 0; margin-left: 0.25rem; }
    /* Ensure clicks don't shift layout */
    header nav { align-items: center; }
  </style>
</header>

