<!-- Header: Floating Glassmorphism Nav Overlaying Hero -->
<header class="fixed top-0 left-0 right-0 z-50">
  <!-- Desktop Navigation -->
  <div class="hidden md:block">
    <div class="mt-8 mx-auto w-[92%] max-w-5xl rounded-2xl bg-white/60 backdrop-blur-xl shadow-lg border border-gray-200">
      <nav class="flex items-center justify-center px-6 py-4">
        <div class="flex items-center space-x-8">
          <a href="/{{ lang }}/" class="flex items-center">
            <img src="{{ site.logo[lang] or site.logo.en }}" alt="Verico Logo" style="height: 48px;" class="block" />
          </a>
          <div class="flex items-center space-x-6">
            {% for nav in navigation.main %}
              {% set t = nav.title[lang] or nav.title['en'] %}
              {% if nav.submenu %}
                <div class="dropdown-container relative" id="products-dropdown">
                  <a href="{{ nav.url[lang] or nav.url.en }}"
                     class="text-sm font-medium text-gray-700 hover:text-gray-900 transition flex items-center">
                    {{ t }}
                    <svg class="w-4 h-4 ml-1 text-gray-400" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 20 20">
                      <path stroke-linecap="round" stroke-linejoin="round" d="M6 8l4 4 4-4"/>
                    </svg>
                  </a>
                  <div class="dropdown-menu absolute left-0 top-full mt-2 min-w-[180px] bg-white/80 border border-gray-200 rounded-xl shadow-lg"
                       style="padding: 4px;">
                    <ul class="py-2">
                      {% for subnav in nav.submenu %}
                        {% set subt = subnav.title[lang] or subnav.title['en'] %}
                        {% if not subnav.available_in or lang in subnav.available_in %}
                          {% if subnav.submenu %}
                            <li class="submenu-item relative">
                              <a href="{{ subnav.url[lang] or subnav.url.en }}"
                                 class="block px-5 py-2 text-sm text-gray-700 hover:bg-gray-100 flex items-center justify-between">
                                {{ subt }}
                                <svg class="w-3 h-3 ml-1 text-gray-400" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 20 20">
                                  <path stroke-linecap="round" stroke-linejoin="round" d="M6 8l4 4 4-4"/>
                                </svg>
                              </a>
                              <ul class="submenu absolute left-full top-0 mt-0 min-w-[160px] bg-white/80 border border-gray-200 rounded-xl shadow-lg"
                                  style="padding: 4px;">
                                {% for subsubnav in subnav.submenu %}
                                  {% set subsubt = subsubnav.title[lang] or subsubnav.title['en'] %}
                                  {% if not subsubnav.available_in or lang in subsubnav.available_in %}
                                    <li>
                                      <a href="{{ subsubnav.url[lang] or subsubnav.url.en }}" class="block px-5 py-2 text-sm text-gray-700 hover:bg-gray-100">{{ subsubt }}</a>
                                    </li>
                                  {% endif %}
                                {% endfor %}
                              </ul>
                            </li>
                          {% else %}
                            <li>
                              <a href="{{ subnav.url[lang] or subnav.url.en }}" class="block px-5 py-2 text-sm text-gray-700 hover:bg-gray-100">{{ subt }}</a>
                            </li>
                          {% endif %}
                        {% endif %}
                      {% endfor %}
                    </ul>
                  </div>
                </div>
              {% else %}
                <a href="{{ nav.url[lang] or nav.url.en }}"
                   class="text-sm font-medium text-gray-700 hover:text-gray-900 transition">{{ t }}</a>
              {% endif %}
            {% endfor %}
          </div>
          <div class="flex items-center gap-4">
            <!-- Language Selector -->
            <select
                class="bg-transparent border border-gray-300 rounded-md px-2 py-1 text-sm text-gray-700 focus:outline-none focus:ring-1 focus:ring-gray-400 w-28"
                style="min-width: 112px;">
              <option value="en" {% if lang == 'en' %}selected{% endif %}>English</option>
              <option value="de" {% if lang == 'de' %}selected{% endif %}>Deutsch</option>
            </select>
          </div>
        </div>
      </nav>
    </div>
  </div>
  
  <!-- Mobile Navigation -->
  <div class="md:hidden flex justify-center w-full">
    <nav class="mt-4 mx-auto w-[92%] max-w-5xl rounded-2xl bg-white/60 backdrop-blur-xl shadow-lg border border-gray-200 flex items-center px-6 py-2 relative">
      <!-- Hamburger (mobile) -->
      <button id="mobile-menu-button" class="flex items-center justify-center mr-4 p-2 rounded-md focus:outline-none focus:ring-2 focus:ring-gray-300 bg-white/40 backdrop-blur-xl border border-gray-200" aria-label="Open main menu">
        <svg class="w-7 h-7 text-gray-700" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" d="M4 7h16M4 12h16M4 17h16"/>
        </svg>
      </button>
      <a href="/{{ lang }}/" class="flex items-center">
        <img src="{{ site.logo[lang] or site.logo.en }}" alt="Verico Logo" style="height: 44px;" class="block" />
      </a>
    </nav>
  </div>
  
  <!-- Mobile Nav Drawer -->
  <div id="mobile-nav-drawer" class="fixed top-0 left-0 h-full w-full bg-white/30 backdrop-blur-xl border-none shadow-lg z-[60] transform -translate-x-full transition-transform duration-200 ease-in-out md:hidden">
    <div class="flex flex-col h-full w-64 bg-white/30 backdrop-blur-xl border-r border-gray-200 shadow-lg">
      <div class="flex items-center justify-between px-6 py-4 border-b border-gray-100">
        <a href="/{{ lang }}/" class="flex items-center">
          <img src="{{ site.logo[lang] or site.logo.en }}" alt="Verico Logo" style="height: 36px;" class="block" />
        </a>
        <button id="mobile-nav-close" class="p-2 rounded-md focus:outline-none focus:ring-2 focus:ring-gray-300" aria-label="Close menu">
          <svg class="w-6 h-6 text-gray-700" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" d="M6 18L18 6M6 6l12 12"/>
          </svg>
        </button>
      </div>
      <nav class="flex-1 flex flex-col gap-2 px-6 py-6">
        {% for nav in navigation.main %}
          {% set t = nav.title[lang] or nav.title['en'] %}
          {% if nav.submenu %}
            <div class="block">
              <button class="flex items-center w-full text-base font-medium text-gray-700 py-2 focus:outline-none" id="mobile-products-toggle">
                {{ t }}
                <svg class="w-4 h-4 ml-1 text-gray-400" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 20 20">
                  <path stroke-linecap="round" stroke-linejoin="round" d="M6 8l4 4 4-4"/>
                </svg>
              </button>
              <div id="mobile-products-menu" class="hidden flex-col pl-4 mt-1">
                {% for subnav in nav.submenu %}
                  {% set subt = subnav.title[lang] or subnav.title['en'] %}
                  {% if not subnav.available_in or lang in subnav.available_in %}
                    {% if subnav.submenu %}
                      <div class="pl-2">
                        <button class="flex items-center w-full text-sm text-gray-700 py-1 focus:outline-none" id="mobile-powerbank-toggle">
                          {{ subt }}
                          <svg class="w-3 h-3 ml-1 text-gray-400" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 20 20">
                            <path stroke-linecap="round" stroke-linejoin="round" d="M6 8l4 4 4-4"/>
                          </svg>
                        </button>
                        <div id="mobile-powerbank-menu" class="hidden flex-col pl-4 mt-1">
                          {% for subsubnav in subnav.submenu %}
                            {% set subsubt = subsubnav.title[lang] or subsubnav.title['en'] %}
                            {% if not subsubnav.available_in or lang in subsubnav.available_in %}
                              <a href="{{ subsubnav.url[lang] or subsubnav.url.en }}" class="block text-xs text-gray-700 py-1">{{ subsubt }}</a>
                            {% endif %}
                          {% endfor %}
                        </div>
                      </div>
                    {% else %}
                      <a href="{{ subnav.url[lang] or subnav.url.en }}" class="block text-sm text-gray-700 py-1">{{ subt }}</a>
                    {% endif %}
                  {% endif %}
                {% endfor %}
              </div>
            </div>
          {% else %}
            <a href="{{ nav.url[lang] or nav.url.en }}" class="block text-base font-medium text-gray-700 py-2">{{ t }}</a>
          {% endif %}
        {% endfor %}
      </nav>
    </div>
  </div>
  
  <!-- Mobile Nav Overlay -->
  <div id="mobile-nav-overlay" class="fixed inset-0 bg-black/50 z-[50] hidden md:hidden"></div>
</header> 