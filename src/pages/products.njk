---
layout: page.njk
title: Products
description: Discover our comprehensive range of high-quality power and storage solutions
---

<div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-8">
    {% for category in site.productCategories.categories %}
    <div class="bg-white border border-gray-200 rounded-2xl shadow-md overflow-hidden">
        <div class="aspect-w-16 aspect-h-9">
            <img src="{{ category.image }}" alt="{{ category.title }}" class="w-full h-48 object-cover" />
        </div>
        <div class="p-6">
            <h3 class="text-xl font-semibold text-gray-800 mb-2">{{ category.title }}</h3>
            <p class="text-gray-600 mb-4">{{ category.subtitle }}</p>
            <a href="{{ category.url }}" class="inline-block px-4 py-2 bg-gray-800 text-white rounded-lg hover:bg-gray-700 transition">
                Learn More
            </a>
        </div>
    </div>
    {% endfor %}
</div> 