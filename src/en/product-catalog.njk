---
title: Products
lang: en
permalink: /en/products/
---

{% set data = products.en %}

<!-- Hero Section -->
<section class="relative w-[99%] h-[300px]">
    <div class="hero-wrapper rounded-2xl border border-gray-200 mx-2 my-3 md:mx-4 md:my-4 overflow-hidden h-full"
         style="box-sizing:border-box;">
        <div class="hero-container relative w-full h-full mx-auto">
            <img src="{{ data.hero.image }}" alt="{{ data.hero.alt }}"
                class="w-full h-full object-cover object-center" />
            <div class="absolute inset-y-10 right-0 flex items-center pr-10">
                <h1 class="text-5xl font-bold text-gray-500 break-words text-left px-6 py-4">
                    {{ data.hero.title | safe }}
                </h1>
            </div>
        </div>
    </div>
</section>

<!-- Product Categories -->
<section class="py-12">
    <div class="max-w-6xl mx-auto px-6">
        <!-- Category Tabs -->
        <div class="flex justify-center gap-4 mb-12">
            {% for category in data.categories %}
            <button class="category-tab {% if loop.first %}active{% endif %} px-6 py-3 rounded-lg font-medium text-sm border border-gray-200" 
                    data-category="{{ category.id }}">
                {{ category.name }}
            </button>
            {% endfor %}
        </div>

        <!-- Product Grids -->
        {% for category in data.categories %}
        <div id="{{ category.id }}-products" class="product-grid {% if not loop.first %}hidden{% endif %}">
            <div class="grid grid-cols-1 sm:grid-cols-2 md:grid-cols-3 gap-8">
                {% for product in data.products[category.id] %}
                <div class="flex flex-col items-center">
                    <div class="bg-white border border-gray-200 rounded-2xl shadow-md flex flex-col items-center w-full max-w-xs mx-auto pb-6">
                        <div class="w-full rounded-t-2xl overflow-hidden bg-gray-50 pt-6 px-6">
                            <img src="{{ product.image }}" alt="{{ product.alt }}" class="object-contain w-full mx-auto" />
                        </div>
                        <div class="w-full mt-6 px-4 text-left">
                            <h3 class="font-bold text-gray-800 mb-1 text-2xl">{{ product.name }}</h3>
                            <p class="text-gray-600 text-sm mb-1">{{ product.description }}</p>
                            <p class="text-gray-500 text-xs mb-4">{{ product.details }}</p>
                            <a href="{{ product.link }}" 
                               class="inline-block bg-gray-800 text-white px-6 py-2 rounded-lg text-sm font-medium hover:bg-gray-700 transition">
                                View Details
                            </a>
                        </div>
                    </div>
                </div>
                {% endfor %}
            </div>
        </div>
        {% endfor %}
    </div>
</section>

<!-- Product Features Section -->
<section class="py-16 bg-gray-50">
    <div class="max-w-5xl mx-auto px-6">
        <div class="text-center mb-12">
            <h2 class="text-3xl font-bold text-gray-800 mb-4">{{ data.features.title }}</h2>
            <p class="text-gray-600 max-w-2xl mx-auto">
                {{ data.features.subtitle }}
            </p>
        </div>
        
        <div class="grid grid-cols-1 md:grid-cols-3 gap-8">
            {% for feature in data.features.items %}
            <div class="text-center">
                <div class="bg-white rounded-full w-16 h-16 flex items-center justify-center mx-auto mb-4">
                    {% if feature.icon == "check" %}
                    <svg class="w-8 h-8 text-gray-800" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m6 2a9 9 0 11-18 0 9 9 0 0118 0z"></path>
                    </svg>
                    {% elif feature.icon == "lightning" %}
                    <svg class="w-8 h-8 text-gray-800" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 10V3L4 14h7v7l9-11h-7z"></path>
                    </svg>
                    {% elif feature.icon == "heart" %}
                    <svg class="w-8 h-8 text-gray-800" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4.318 6.318a4.5 4.5 0 000 6.364L12 20.364l7.682-7.682a4.5 4.5 0 00-6.364-6.364L12 7.636l-1.318-1.318a4.5 4.5 0 00-6.364 0z"></path>
                    </svg>
                    {% endif %}
                </div>
                <h3 class="text-lg font-semibold text-gray-800 mb-2">{{ feature.title }}</h3>
                <p class="text-gray-600 text-sm">{{ feature.description }}</p>
            </div>
            {% endfor %}
        </div>
    </div>
</section>

<script>
document.addEventListener('DOMContentLoaded', function() {
    const categoryTabs = document.querySelectorAll('.category-tab');
    const productGrids = document.querySelectorAll('.product-grid');
    
    categoryTabs.forEach(tab => {
        tab.addEventListener('click', function() {
            const category = this.getAttribute('data-category');
            
            // Remove active class from all tabs
            categoryTabs.forEach(t => t.classList.remove('active'));
            // Add active class to clicked tab
            this.classList.add('active');
            
            // Hide all product grids
            productGrids.forEach(grid => grid.classList.add('hidden'));
            // Show selected category grid
            document.getElementById(category + '-products').classList.remove('hidden');
        });
    });
});
</script> 