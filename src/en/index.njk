---
layout: layout.njk
title: Home
lang: en
permalink: /en/index.html
---
{% set data = homepage.en %}

<!-- Hero Section -->
<section class="relative w-[99%] h-[800px] -mt-24">
    <div class="hero-wrapper rounded-2xl border border-gray-200 mx-2 my-3 md:mx-4 md:my-4 overflow-hidden h-full" style="box-sizing:border-box;">
        <div class="hero-container relative w-full h-full mx-auto">
            <a href="#" class="block w-full h-full">
                <img src="{{ ('/' + data.hero.image) | url }}" alt="{{ data.hero.alt }}" class="w-full h-full object-cover object-center" />
                <div class="absolute inset-y-10 right-0 flex items-center pr-10 pointer-events-none">
                    <h1 class="text-5xl font-bold text-gray-500 break-words text-left px-6 py-4">
                        {{ data.hero.title | safe }}
                    </h1>
                </div>
            </a>
        </div>
    </div>
</section>

<!-- Products by Category Section -->
<section class="py-5">
    <div class="max-w-6xl mx-auto px-6 ">
        <div class="mb-3 mt-0">
            <h1 class="text-5xl font-bold tracking-tight text-gray-800 mb-0 mt-0 break-words text-center">
                {{ data.categories.title }}
            </h1>
        </div>
        <div class="flex justify-center gap-3 my-6">
            {% for button in data.categories.buttons %}
            <a href="{{ button.url }}" class="px-4 py-1.5 bg-white border border-gray-200 text-gray-700 rounded-lg font-medium text-xs focus:outline-none" style="letter-spacing:0.01em;">{{ button.text }}</a>
            {% endfor %}
        </div>
        <div class="flex flex-col md:flex-row w-full h-auto md:h-[400px] gap-4">
            {% for item in data.categories.items %}
            <a href="{{ item.url }}" class="relative overflow-hidden rounded-2xl flex-1 block md:group md:transition-all md:duration-300 md:hover:flex-[4]">
                <img src="{{ ('/' + item.image) | url }}" class="w-full h-56 md:h-full object-cover" />
                <div class="absolute top-0 left-0 p-5">
                    <h3 class="text-xl font-semibold {% if loop.index == 3 %}text-black{% else %}text-white{% endif %} mb-2">{{ item.title }}</h3>
                    <p class="{% if loop.index == 3 %}text-gray-800{% else %}text-gray-200{% endif %} text-sm">{{ item.description }}</p>
                </div>
            </a>
            {% endfor %}
        </div>
    </div>
</section>

<!-- Trending Products Section -->
<section class="py-8">
    <div class="max-w-6xl mx-auto px-6">
        <div class="mb-8">
            <h1 class="text-5xl font-bold tracking-tight text-gray-800 text-center mb-2">
                {{ data.trending.title }}
            </h1>
        </div>
        <div class="grid grid-cols-1 sm:grid-cols-2 md:grid-cols-3 gap-8">
            {% for product in data.trending.products %}
            <a href="{{ product.url }}" class="flex flex-col items-center group">
                <div class="bg-white border border-gray-200 rounded-2xl shadow-md flex flex-col items-center w-full max-w-xs mx-auto pb-6">
                    <div class="w-full rounded-t-2xl overflow-hidden bg-gray-50 pt-6 px-6">
                        <img src="{{ ('/' + product.image) | url }}" alt="{{ product.name }}" class="object-contain w-full mx-auto" />
                    </div>
                    <div class="w-full mt-6 px-4 text-left ">
                        <h3 class="font-bold text-gray-800 mb-1 text-2xl">{{ product.name }}</h3>
                        <p class="text-gray-600 text-sm mb-1">{{ product.description }}</p>
                        <p class="text-gray-500 text-xs">{{ product.details }}</p>
                    </div>
                </div>
            </a>
            {% endfor %}
        </div>
    </div>
</section>

<!-- Tagline Section -->
<section class="w-full py-12">
    <div class="max-w-3xl mx-auto px-4">
        <h2 class="text-center text-2xl md:text-3xl font-semibold text-gray-800 tracking-tight" style="font-family: 'Times New Roman', Times, serif;">
            {{ data.tagline }}
        </h2>
    </div>
</section>

<!-- About Section -->
<section class="bg-gray-800 py-24">
    <div class="max-w-5xl mx-auto px-6 grid md:grid-cols-2 gap-12 items-center">
        <div>
            <h2 class="text-2xl font-bold text-white mb-6">{{ data.about.title }}</h2>
            <p class="text-gray-500 mb-4">{{ data.about.content1 }}</p>
            <p class="text-gray-500 mb-6">{{ data.about.content2 }}</p>
        </div>
        <div>
            <div class="aspect-w-4 aspect-h-3 bg-gray-800 rounded-lg flex items-center justify-center text-gray-500 text-sm">
                <img src="{{ ('/' + site.en.logo_white) | url }}" alt="Verico Logo" class="h-32 w-auto mx-auto" />
            </div>
        </div>
    </div>
</section>

